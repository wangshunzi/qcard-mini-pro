@import "../../styles/card.wxss";

.story {
  position: relative;
  display: flex;
  overflow: hidden;
  flex-direction: column;
  background: var(--color-card);
  color:var(--color-text-secondary);
}

.scene {
  display:block;
  flex:0 0 auto;
  width: 100%;
  aspect-ratio:4/3;
  background:#000;
}

.preview-scene-frame {
  position: relative;
  width: 100%;
  flex: 0 0 auto;
  overflow: hidden;
  background:var(--color-surface-soft);
}

.preview-scene {
  display: block;
  width: 100%;
  height:auto;
  max-width: 100%;
  aspect-ratio:auto;
  background: transparent;
}

.preview-scene-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color:var(--color-text-muted);
  font-size: 14px;
  font-weight: 700;
}

.dialogue-list {
  flex: 1;
  min-height: 0;
  background:var(--color-card);
}

.dialogue-content { padding:6px 0 10px; }

.dialogue {
  width:auto;
  max-width:calc(100% - 20px);
  display: flex;
  align-items:flex-start;
  gap:8px;
  margin:3px 10px;
  padding:4px 6px;
  border:1px solid transparent;
  border-radius:12px;
  background: transparent;
  opacity:.49;
  transition:opacity .18s ease,background .18s ease;
}
.dialogue.distance-0 { opacity:1; }
.dialogue.distance-1 { opacity:.83; }
.dialogue.distance-2 { opacity:.66; }
.dialogue.left { margin-right:auto; }
.dialogue.right { margin-left:auto; justify-content:flex-end; }
.dialogue.narrator { display:block; max-width:none; margin:3px 24px; padding:8px 12px; text-align:center; }
.dialogue.narrator.active { border-color:rgba(79,143,236,.34); background:var(--color-info-soft); }
.narrator-copy { color:var(--color-text-secondary); font-size:16px; line-height:1.5; font-style:italic; }
.dialogue.narrator.active .narrator-copy { color:var(--color-secondary-20); font-weight:800; }

.avatar-column { width:44px; flex:0 0 44px; display:flex; flex-direction:column; align-items:center; gap:6px; }
.role-label { max-width:44px; overflow:hidden; color:var(--color-text-muted); font-size:9px; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
.avatar {
  width:32px;
  height:32px;
  border:2px solid #e4e8ee;
  border-radius: 50%;
  background:var(--color-surface-soft);
}
.avatar.focused { border-color:var(--color-secondary-20); }
.speech-bubble { max-width:80%; padding:8px 12px; border:1px solid #e4e8ee; border-radius:12px; color:var(--color-text-secondary); background:var(--color-card); font-size:16px; line-height:1.5; }
.left .speech-bubble { border-bottom-left-radius:4px; }
.right .speech-bubble { border-color:rgba(79,143,236,.27); border-bottom-right-radius:4px; background:rgba(79,143,236,.09); }
.dialogue.active .speech-bubble { color:var(--color-secondary-20); font-weight:800; }
.distance-1 .speech-bubble,.distance-1 .narrator-copy { font-size:15px; }
.distance-2 .speech-bubble,.distance-2 .narrator-copy { font-size:14px; }
.distance-3 .speech-bubble,.distance-3 .narrator-copy { font-size:12px; }

.audio-player {
  flex:0 0 auto;
  padding:10px 16px 12px;
  box-sizing: border-box;
  border-top:1px solid #e4e8ee;
  background:var(--color-card);
}
.progress-row { display:grid; grid-template-columns:56rpx 1fr 56rpx; align-items:center; gap:8px; margin-bottom:10px; }
.player-controls { display:grid; grid-template-columns:44px 1fr 44px; align-items:center; }

.play-button {
  display: flex;
  justify-self:center;
  align-items: center;
  justify-content: center;
  width:52px;
  height:52px;
  border-radius: 50%;
  background: #4F8FEC;
  color: var(--color-text-inverse);
  font-size: 15px;
}

.slider {
  min-width:0;
  margin:0;
}

.time {
  color:var(--color-text-muted);
  font-size:11px;
  text-align:center;
}

.rate {
  width:44px;
  height:32px;
  border-radius:8px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--color-surface-soft);
  color:var(--color-text-secondary);
  font-size:13px;
  font-weight:600;
}

.preview-body {
  position: relative;
  flex: 1 0 116px;
  min-height: 116px;
  padding:10px 12px 12px;
  overflow: hidden;
  display:flex;
  flex-direction:column;
  gap:10px;
  background:var(--color-card);
}

.preview-roles {
  align-self: center;
  flex: 0 0 38px;
  width: 100%;
  max-width: 220px;
  height: 38px;
  min-height: 38px;
  overflow: hidden;
}

.preview-roles-inner {
  display: flex;
  width: 100%;
  flex-wrap: nowrap;
  justify-content: center;
  gap:12px;
}

.preview-role {
  display: flex;
  align-items: center;
  justify-content: center;
  width:34px;
  flex:0 0 34px;
}

.preview-avatar-frame,
.preview-avatar {
  width:34px;
  height:34px;
  border-radius: 50%;
}

.preview-avatar-frame {
  overflow: hidden;
  background:var(--color-surface-soft);
  box-shadow: inset 0 0 0 1px rgba(37,48,71,.08);
}

.preview-dialogues { display:flex; flex-direction:column; gap:8px; }

.preview-dialogue-row {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 8px;
}

.preview-dialogue-row.narrator {
  padding-left: 0;
}

.preview-dialogue-avatar {
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  border: 1px solid #e4e8ee;
  border-radius: 50%;
  background:var(--color-surface-soft);
}

.preview-line {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color:var(--color-text);
  color:var(--color-text-secondary);
  font-size:13px;
  line-height:1.54;
  font-weight:500;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
}

.preview-speaker {
  color:var(--color-secondary-20);
  font-weight: 800;
}

.preview-story {
  min-height:0;
  overflow: hidden;
  padding:0 2px;
  color:var(--color-text-secondary);
  font-size:12px;
  line-height:1.5;
}

.preview-fade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height:28px;
  background:linear-gradient(transparent,#fff);
}

.preview-scene-skeleton {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(90deg,var(--color-skeleton-base),var(--color-skeleton-highlight),var(--color-skeleton-base));
  background-size: 200% 100%;
  animation: story-skeleton 1.15s ease-in-out infinite;
}

@keyframes story-skeleton {
  from { background-position: 100% 0; }
  to { background-position: -100% 0; }
}

@keyframes bar {
  from { transform: scaleY(.5); }
  to { transform: scaleY(1.25); }
}
