@import "../../styles/card.wxss";

.listening {
  --primary: #6f9b7b;
  --success: #5f9e73;
  --error: #c96a55;
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 12rpx;
  background: #dceeff;
}

.card-background,
.ambient-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.card-background {
  z-index: 0;
}

.ambient-shade {
  z-index: 1;
  background: linear-gradient(180deg, rgba(21, 48, 38, .44), rgba(21, 48, 38, .05) 42%, rgba(21, 48, 38, .48));
}

.listen-content,
.preview-content,
.answer-content {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.listen-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 36rpx 32rpx 32rpx;
}

.listening-header {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.header-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.header-chip {
  height: 48rpx;
  padding: 0 20rpx;
  border: 2rpx solid rgba(255, 255, 255, .2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: rgba(255, 255, 255, .88);
  background: rgba(255, 255, 255, .14);
  font-size: 22rpx;
  font-weight: 800;
}

.header-title {
  padding: 0 16rpx;
  overflow: hidden;
  color: #fff;
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 900;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .28);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.listen-hero {
  position: relative;
  min-height: 392rpx;
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 20rpx;
  box-sizing: border-box;
}

.glass-play {
  position: relative;
  z-index: 2;
  width: 172rpx;
  height: 172rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, .18);
  box-shadow: 0 20rpx 56rpx rgba(44, 31, 16, .36);
}

.glass-play-inner {
  width: 100%;
  height: 100%;
  border: 2rpx solid rgba(255, 255, 255, .42);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, .18);
}

.idle-pulse { animation: listen-pulse 1.52s ease-in-out infinite; }
.audio-pulse { animation: listen-pulse 1.04s ease-in-out infinite; }

.transcript-overlay {
  position: absolute;
  inset: 0 20rpx 220rpx;
  z-index: 3;
  padding: 28rpx 32rpx 36rpx;
  box-sizing: border-box;
  opacity: 0;
  transform: scale(.975);
  pointer-events: none;
  transition: opacity 220ms ease, transform 220ms ease;
}

.transcript-overlay.transcript-visible {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

.transcript-paragraph {
  color: rgba(236, 240, 244, .9);
  font-size: 30rpx;
  line-height: 1.74;
  font-weight: 800;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .72);
}
.transcript-paragraph + .transcript-paragraph { margin-top:18rpx; }

.listen-actions {
  flex: none;
  display: grid;
  grid-template-columns: 88rpx 88rpx 1fr;
  align-items: center;
  gap: 16rpx;
}

.round-action,
.start-answer {
  height: 88rpx;
  border: 2rpx solid rgba(255, 255, 255, .2);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: rgba(255, 255, 255, .14);
  font-size: 26rpx;
  font-weight: 900;
}

.start-answer {
  gap: 12rpx;
  color: rgba(255, 255, 255, .72);
  opacity: .48;
}

.start-answer.start-ready {
  border-color: rgba(111, 155, 123, .55);
  color: #244d3f;
  background: rgba(255, 248, 233, .94);
  opacity: 1;
  animation: start-pulse 1.5s ease-in-out infinite;
}

.action-active {
  background: rgba(111, 155, 123, .28);
}

.preview-content {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.compact-header {
  gap: 10rpx;
}

.compact-header .header-chip {
  height: 36rpx;
  padding: 0 14rpx;
  border-color: rgba(255, 248, 233, .62);
  border-radius: 18rpx;
  color: #244d3f;
  background: rgba(255, 248, 233, .64);
  font-size: 16rpx;
}

.compact-header .header-title {
  padding: 0 4rpx;
  color: #fff8e9;
  font-size: 20rpx;
}

.preview-play {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto;
  border: 6rpx solid rgba(255, 255, 255, .34);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(44, 31, 16, .3);
}

.answer-content {
  color: #244d3f;
}

.answer-topbar {
  position: absolute;
  z-index: 2;
  left: 7%;
  right: 7%;
  top: 2.6%;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.answer-back {
  display: flex;
  align-items: center;
  color: rgba(255, 255, 255, .94);
  font-size: 24rpx;
  font-weight: 900;
}

.answer-stepper {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.answer-step {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid rgba(255, 255, 255, .48);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #244d3f;
  background: rgba(255, 255, 255, .74);
  font-size: 20rpx;
  font-weight: 900;
}

.answer-step.current,
.answer-step.answered {
  color: #fff;
}

.question-bubble {
  position: absolute;
  z-index: 2;
  left: 10%;
  right: 11%;
  top: 16%;
  height: 27%;
  box-sizing: border-box;
}

.question-bubble-body {
  position:absolute;
  inset:0 0 54rpx;
  padding:24rpx 56rpx 18rpx 32rpx;
  box-sizing:border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.question-copy {
  max-height: 100%;
  overflow: hidden;
  color: #244d3f;
  font-size: 34rpx;
  line-height: 1.45;
  font-weight: 900;
  text-align: center;
}

.question-audio {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(111, 155, 123, .18);
}

.completion-inline {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  font-size: 36rpx;
  font-weight: 900;
}

.answer-options {
  position: absolute;
  z-index: 2;
  left: 7%;
  right: 7%;
  top: 53%;
  height: 25%;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.answer-option {
  min-width: 0;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(116, 83, 41, .22);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #173b57;
  background: rgba(255, 253, 246, .96);
  box-shadow: 0 10rpx 20rpx rgba(91, 59, 21, .18);
}

.answer-option.correct {
  border-color: var(--success);
  color: var(--success);
  transform: scale(1.03);
}

.answer-option.wrong {
  border-color: var(--error);
  color: var(--error);
  animation: option-shake 280ms ease;
}

.option-letter {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #244d3f;
  background: #e6efe7;
  font-size: 24rpx;
  font-weight: 900;
}

.option-copy {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 800;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.answer-controls {
  position: absolute;
  z-index: 2;
  left: 7%;
  right: 7%;
  bottom: 4%;
  height: 88rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.answer-play {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border: 2rpx solid rgba(255, 255, 255, .2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary);
}

.restart-answer,
.answer-nav {
  flex: 1;
  height: 88rpx;
  border: 2rpx solid rgba(255, 255, 255, .2);
  border-radius: 44rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, .14);
}

.restart-answer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #fff;
  background: var(--primary);
  font-size: 26rpx;
  font-weight: 900;
}

.answer-nav {
  padding: 8rpx;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 10rpx;
}

.nav-option {
  height: 68rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #244d3f;
  background: rgba(255, 248, 233, .9);
  font-size: 22rpx;
  font-weight: 900;
}

.nav-option.disabled {
  opacity: .4;
}

.answer-progress-label {
  min-width: 72rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  text-align: center;
}

.question-wrong { animation: question-shake 280ms ease; }
.question-correct { animation: question-pop 340ms ease; }

@keyframes listen-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes start-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

@keyframes question-shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  50% { transform: translateX(10rpx); }
  75% { transform: translateX(-6rpx); }
}

@keyframes question-pop {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@keyframes option-shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  50% { transform: translateX(10rpx); }
  75% { transform: translateX(-6rpx); }
}
