@import "../../styles/card.wxss";
.choice { background-size:cover; background-position:center; background-color:var(--color-info-soft); }
.scrim { position:absolute; inset:0; background:rgba(15,44,73,.16); }
.content { position:relative; z-index:1; height:100%; padding:56rpx 32rpx 44rpx; display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box; }
.content.preview { padding:48rpx 24rpx 28rpx; justify-content:center; gap:32rpx; }
.question-wrap { width:100%; display:flex; justify-content:center; animation:float 2400ms ease-in-out infinite; }
.question-wrap.playing { animation:float 2400ms ease-in-out infinite,pulse 620ms ease-in-out infinite alternate; }
.preview .question-wrap { animation:none; }
.question-stage { position:relative; width:100%; height:460rpx; transform-style:preserve-3d; }
.preview .question-stage { height:232rpx; }
.question-face { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; backface-visibility:hidden; transition:transform 520ms ease; }
.question-front { transform:rotateX(0deg); }.question-back { transform:rotateX(180deg); }
.show-answer .question-front { transform:rotateX(180deg); }.show-answer .question-back { transform:rotateX(360deg); }
.question-frame { position:relative; width:82%; min-height:340rpx; max-height:460rpx; aspect-ratio:1; padding:32rpx; display:flex; align-items:center; justify-content:center; border:4rpx solid; border-radius:56rpx; background: var(--color-glass); box-shadow:0 16rpx 36rpx rgba(36,91,143,.2); box-sizing:border-box; }
.question-frame.image-mode { padding:0; overflow:visible; }.preview .question-frame { width:62%; min-height:176rpx; max-height:224rpx; padding:20rpx; border-width:2rpx; border-radius:36rpx; }.preview .question-frame.image-mode { padding:0; }
.question-image { width:100%; height:100%; border-radius:52rpx; }.preview .question-image { border-radius:32rpx; }
.question-text { font-size:62rpx; line-height:1.28; font-weight:900; text-align:center; }.preview .question-text { font-size:30rpx; }
.audio-badge { position:absolute; left:50%; bottom:-36rpx; width:72rpx; height:72rpx; margin-left:-36rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:var(--color-text-inverse); box-shadow:0 6rpx 16rpx rgba(0,0,0,.16); font-size:32rpx; }
.answer-card { width:86%; min-height:340rpx; max-height:460rpx; padding:36rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; border:4rpx solid; border-radius:56rpx; box-shadow:0 16rpx 36rpx rgba(36,91,143,.2); box-sizing:border-box; }
.answer-title { margin-bottom:18rpx; font-size:48rpx; line-height:1.3; font-weight:900; text-align:center; }.answer-text { font-size:28rpx; line-height:1.55; font-weight:700; text-align:center; }
.options { min-height:296rpx; display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:24rpx 20rpx; }
.preview .options { min-height:0; gap:12rpx 10rpx; padding:0 16rpx; }
.option { position:relative; width:152rpx; min-height:152rpx; padding:16rpx; display:flex; align-items:center; justify-content:center; border:4rpx solid; border-radius:44rpx; box-shadow:0 10rpx 20rpx rgba(79,143,236,.12); box-sizing:border-box; transition:transform 160ms ease,border-color 160ms ease; }
.status-icon { position:absolute; top:8rpx; right:8rpx; }
.option.text-option { width:auto; min-width:164rpx; max-width:296rpx; min-height:128rpx; padding:20rpx 28rpx; border-radius:40rpx; }
.option.wrong { animation:shake 275ms linear; }.option.correct { transform:scale(1.09); }
.option-image { width:108rpx; height:108rpx; border-radius:22rpx; }.option-text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:34rpx; line-height:1.3; font-weight:800; text-align:center; }
.preview .option { width:76rpx; min-height:76rpx; padding:8rpx; border-width:2rpx; border-radius:26rpx; box-shadow:none; }.preview .option.text-option { width:auto; min-width:96rpx; max-width:176rpx; min-height:64rpx; padding:8rpx 14rpx; border-radius:22rpx; }.preview .option-image { width:54rpx; height:54rpx; }.preview .option-text { font-size:18rpx; }
@keyframes float { 50% { transform:translateY(-16rpx); } }
@keyframes pulse { to { transform:scale(1.05); } }
@keyframes shake { 20%{transform:translateX(-16rpx)}40%{transform:translateX(16rpx)}60%{transform:translateX(-12rpx)}80%{transform:translateX(12rpx)} }
