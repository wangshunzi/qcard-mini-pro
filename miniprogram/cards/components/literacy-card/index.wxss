@import "../../styles/card.wxss";

.literacy {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(35, 62, 48, .09);
  background: #f8f7f1;
}

.top-section {
  position: relative;
  height: 29%;
  min-height: 104px;
  overflow: hidden;
  background: #e2f0e5;
}

.illustration,
.top-gradient {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.top-gradient {
  background: linear-gradient(transparent 38%, rgba(16, 35, 24, .25));
}

.variants {
  position: absolute;
  bottom: 11px;
  left: 50%;
  z-index: 3;
  display: flex;
  padding: 3px;
  transform: translateX(-50%);
  border-radius: 16px;
  background: rgba(40, 54, 45, .28);
  backdrop-filter: blur(8px);
}

.variant {
  min-width: 46px;
  padding: 6px 10px;
  border-radius: 13px;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  text-align: center;
}

.variant.active {
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 3px 9px rgba(0, 0, 0, .12);
  color: #3e7253;
}

.conversation-button {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border: 1px solid rgba(255, 255, 255, .6);
  border-radius: 50%;
  background: rgba(0, 0, 0, .18);
  color: #fff;
  font-size: 18px;
}

.content-panel {
  display: flex;
  flex-direction: column;
  height: 71%;
  background: rgba(0, 0, 0, .018);
}

.character-section {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 0;
  flex-direction: column;
}

.writer-wrap {
  width: 185px;
  height: 185px;
}

.character-tools {
  display: flex;
  margin-top: 4px;
  gap: 9px;
}

.tool,
.trace-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 30px;
  padding: 5px 12px;
  border: 1px solid rgba(52, 93, 70, .13);
  border-radius: 15px;
  background: rgba(255, 255, 255, .78);
  color: #4b6356;
  font-size: 11px;
  font-weight: 700;
  gap: 4px;
}

.tool.primary,
.trace-action.primary {
  border-color: rgba(62, 126, 83, .2);
  background: #dff0e4;
  color: #39734e;
}

.bottom-content {
  flex: 0 0 105px;
  padding: 10px 14px 12px;
  box-sizing: border-box;
  border-top: .5px solid rgba(35, 62, 48, .1);
}

.meaning-row {
  display: flex;
  align-items: center;
  color: #4d6156;
  font-size: 12px;
}

.meaning-label {
  margin-right: 8px;
  padding: 2px 7px;
  border-radius: 8px;
  background: #e0eee4;
  color: #3f7552;
  font-size: 9px;
  font-weight: 800;
}

.meaning {
  flex: 1;
}

.phrases {
  width: 100%;
  margin-top: 10px;
  white-space: nowrap;
}

.phrases-inner {
  display: inline-flex;
  gap: 9px;
}

.phrase,
.preview-phrase {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 70px;
  padding: 6px 10px;
  border: 1px solid rgba(65, 124, 84, .16);
  border-radius: 14px;
  background: #e4f1e7;
  color: #3e5649;
  font-size: 12px;
  font-weight: 700;
}

.phrase-pinyin,
.conversation-pinyin {
  color: #568166;
  font-size: 8px;
  font-weight: 500;
}

.speaking {
  animation: speaking .65s ease-in-out infinite alternate;
}

.modal-layer,
.trace-layer,
.readonly-overlay,
.preview-overlay {
  position: absolute;
  inset: 0;
  z-index: 40;
}

.modal-mask,
.trace-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(18, 31, 24, .38);
  backdrop-filter: blur(8px);
}

.conversation-panel {
  position: absolute;
  right: 18px;
  bottom: 18px;
  left: 18px;
  max-height: 70%;
  overflow: hidden;
  border-radius: 22px;
  background: rgba(252, 253, 251, .97);
  box-shadow: 0 14px 36px rgba(18, 39, 26, .25);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 17px;
  border-bottom: 1px solid rgba(38, 69, 51, .08);
  color: #355544;
  font-size: 14px;
  font-weight: 900;
}

.conversation-heading {
  display: flex;
  align-items: center;
  gap: 8px;
}

.conversation-heading-image {
  width: 32px;
  height: 26px;
}

.conversation-list {
  max-height: 330px;
}

.conversation-avatar {
  flex: 0 0 34px;
  width: 34px;
  height: 34px;
  border: 2px solid rgba(255, 255, 255, .88);
  border-radius: 50%;
  background: #e6efe8;
  box-shadow: 0 3px 8px rgba(28, 56, 38, .12);
}

.conversation-line {
  display: flex;
  align-items: center;
  padding: 12px 16px;
  border-bottom: .5px solid rgba(38, 69, 51, .07);
  color: #475b50;
  font-size: 13px;
  gap: 9px;
}

.conversation-text {
  flex: 1;
}

.trace-layer {
  z-index: 50;
  animation: trace-in .3s ease-out;
}

.trace-content {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 18px;
}

.trace-title {
  margin-bottom: 12px;
  color: #fff;
  font-size: 18px;
  font-weight: 900;
  text-shadow: 0 2px 5px rgba(0, 0, 0, .22);
}

.trace-writer {
  width: min(82vw, 355px);
  height: min(82vw, 355px);
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, .88);
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 14px 34px rgba(0, 0, 0, .25);
}

.trace-status {
  margin-top: 10px;
  color: #f0f3f1;
  font-size: 11px;
  font-weight: 700;
}

.trace-status.completed {
  color: #c5f5d5;
  font-size: 14px;
}

.trace-actions {
  display: flex;
  margin-top: 12px;
  gap: 12px;
}

.trace-action {
  min-width: 90px;
  background: rgba(255, 255, 255, .92);
}

.preview-character-grid {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130px;
  height: 130px;
  margin: 20px auto 0;
  border: 1px solid rgba(40, 68, 53, .18);
  background: rgba(255, 255, 255, .95);
  color: #315b43;
  font-family: serif;
  font-size: 82px;
  font-weight: 600;
}

.grid-line {
  position: absolute;
  opacity: .28;
}

.grid-line.horizontal {
  top: 50%;
  right: 0;
  left: 0;
  border-top: 1px dashed #51715f;
}

.grid-line.vertical {
  top: 0;
  bottom: 0;
  left: 50%;
  border-left: 1px dashed #51715f;
}

.preview-phrases {
  display: flex;
  justify-content: center;
  margin-top: 20px;
  gap: 10px;
}

.preview-overlay {
  z-index: 30;
  background: rgba(123, 132, 127, .08);
}

@keyframes speaking {
  from { transform: scale(1); opacity: .72; }
  to { transform: scale(1.08); opacity: 1; }
}

@keyframes trace-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* H5/Client 同源版式：顶部插画 + 浮层字板 + 释义与词组卡片。 */
.literacy { display:flex; flex-direction:column; border-radius:8rpx; background:radial-gradient(circle at top,rgba(255,255,255,.26),transparent 48%),linear-gradient(180deg,#fbfff6 0%,#eef8e5 48%,#e2f0d7 100%); color:#162b08; }
.top-section { flex:0 0 auto; width:100%; height:auto; min-height:0; aspect-ratio:5/3; }
.top-gradient { background:linear-gradient(180deg,rgba(15,15,15,.08),rgba(15,15,15,.34)); }
.variants { top:12px; bottom:auto; padding:4px; border:1px solid rgba(255,255,255,.54); border-radius:999px; background:rgba(15,15,15,.22); box-shadow:0 10px 18px rgba(15,15,15,.16); }
.variant { min-width:0; padding:5px 10px; border-radius:999px; font-size:13px; }
.variant.active { color:#fff; background:linear-gradient(135deg,#5daf15,#74c328); }
.conversation-button { top:12px; right:12px; width:40px; height:40px; border-color:rgba(255,255,255,.54); background:rgba(15,15,15,.22); }
.content-panel { position:relative; z-index:2; flex:1; min-height:0; height:auto; margin-top:-34px; border-radius:28px 28px 0 0; background:linear-gradient(180deg,rgba(255,255,255,.94),rgba(248,255,241,.98)); box-shadow:0 -14px 24px rgba(15,15,15,.08); }
.character-section { display:flex; justify-content:center; flex:none; padding:0 12px; }
.character-row { display:flex; width:100%; align-items:flex-end; justify-content:center; gap:8px; margin-top:-30px; }
.side-tool { align-self:flex-end; display:flex; min-width:0; max-width:74px; flex:1; align-items:center; justify-content:center; gap:5px; padding:8px 7px; box-sizing:border-box; border:1px solid rgba(82,153,23,.12); border-radius:999px; color:#315b18; background:rgba(255,255,255,.96); box-shadow:0 12px 22px rgba(82,153,23,.1); font-size:12px; font-weight:700; white-space:nowrap; }
.side-tool text { display:block; flex:none; white-space:nowrap; writing-mode:horizontal-tb; }
.side-tool.active { color:#fff; background:#529917; }
.character-cluster { display:flex; flex-direction:column; align-items:center; }
.pronounce-button { position:relative; z-index:2; display:flex; align-items:center; gap:6px; padding:7px 14px; border:1px solid rgba(82,153,23,.12); border-radius:999px; color:#529917; background:rgba(255,255,255,.98); box-shadow:0 10px 20px rgba(82,153,23,.12); transform:translateY(14px); font-size:14px; font-weight:700; }
.writer-wrap { width:148px; height:148px; margin:4px 0 0; padding:10px; box-sizing:border-box; border:1px solid rgba(82,153,23,.12); border-radius:22px; background:linear-gradient(180deg,#fff,#f7fff2); box-shadow:0 22px 38px rgba(82,153,23,.12); }
.writer-fallback { position:relative; display:flex; width:100%; height:100%; overflow:hidden; align-items:center; justify-content:center; box-sizing:border-box; border:3rpx solid #d9e5cf; border-radius:24rpx; background:#fff; color:#529917; font-family:serif; font-size:76px; font-weight:500; }
.bottom-content { display:flex; flex:1; min-height:0; flex-direction:column; gap:10px; padding:6px 12px 12px; border:0; }
.meaning-card { width:100%; padding:12px; box-sizing:border-box; border:1px solid rgba(82,153,23,.12); border-radius:18px; background:rgba(255,255,255,.94); box-shadow:0 16px 26px rgba(82,153,23,.08); }
.meaning-heading { display:flex; align-items:center; justify-content:space-between; color:#529917; }
.meaning-heading-left { display:flex; align-items:center; gap:6px; font-size:12px; font-weight:800; letter-spacing:.14em; }
.meaning { display:block; margin-top:8px; color:#162b08; font-size:14px; font-weight:700; line-height:1.6; }
.phrases-section { display:flex; flex:1; min-height:0; flex-direction:column; gap:10px; }
.section-title { margin-left:6px; color:#63705e; font-size:13px; font-weight:700; }
.phrases-grid { display:flex; flex:1; min-height:0; flex-wrap:wrap; align-content:center; justify-content:center; row-gap:8px; }
.phrase { width:44%; min-width:0; margin:0 3%; padding:8px 12px; box-sizing:border-box; border:1px solid rgba(82,153,23,.16); border-radius:999px; flex-direction:row; justify-content:space-between; background:linear-gradient(180deg,#ecf9de,#dff5c7); box-shadow:0 12px 20px rgba(82,153,23,.08); color:#162b08; transform:rotate(-1deg); }
.phrase:nth-child(even) { transform:rotate(1.5deg); }
.phrase-copy { min-width:0; display:flex; align-items:center; }
.phrase-aligned { display:flex; align-items:flex-end; justify-content:center; white-space:nowrap; }
.phrase-segment { display:flex; min-width:22px; align-items:center; flex-direction:column; }
.phrase-segment + .phrase-segment { margin-left:4px; }
.phrase-pinyin { color:#8c9d82; font-size:10px; }
.phrase-character { color:#162b08; font-size:14px; font-weight:700; line-height:1.25; }
.speaking-card { box-shadow:0 14px 24px rgba(82,153,23,.14),0 0 0 6px rgba(82,153,23,.06); }
.modal-layer { z-index:60; }
.modal-mask { background:rgba(15,15,15,.32); backdrop-filter:blur(10px); }
.conversation-panel { right:0; bottom:0; left:0; max-height:72%; overflow:visible; border-radius:28px 28px 0 0; background:rgba(255,255,255,.96); box-shadow:0 -14px 26px rgba(15,15,15,.16); animation:conversation-up .26s cubic-bezier(.18,.89,.32,1.18); }
.conversation-panel.closing { animation:conversation-down .26s ease-in forwards; }
.conversation-floating-image { position:absolute; top:-46px; left:10px; z-index:2; width:96px; height:96px; }
.panel-header { min-height:62px; padding:16px 20px 14px 98px; box-sizing:border-box; border-radius:28px 28px 0 0; color:#162b08; background:rgba(255,255,255,.96); font-size:16px; font-weight:800; }
.conversation-list { max-height:400px; overflow:hidden; padding:18px 20px 22px; box-sizing:border-box; background:rgba(255,255,255,.96); }
.conversation-line { display:flex; align-items:flex-start; padding:0; border:0; gap:10px; }
.conversation-line + .conversation-line { margin-top:16px; }
.conversation-line.right { justify-content:flex-end; }
.conversation-avatar-column { display:flex; flex-direction:column; align-items:center; }
.conversation-avatar { display:block; flex:0 0 42px; width:42px; height:42px; overflow:hidden; box-sizing:border-box; border:2px solid #fff; border-radius:50%; box-shadow:0 10px 18px rgba(15,15,15,.12); }
.conversation-audio { width:28px; height:28px; margin-top:4px; border:1px solid #dff5c7; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#fff; }
.conversation-line.right .conversation-audio { border-color:transparent; background:#529917; }
.conversation-bubble { max-width:72%; padding:10px 14px; border:1px solid #dff5c7; border-radius:18px; display:flex; flex-direction:column; box-shadow:0 10px 18px rgba(15,15,15,.08); background:#fff; color:#162b08; }
.conversation-line.right .conversation-bubble { border-color:transparent; background:#529917; color:#fff; }
.conversation-aligned { display:flex; flex-wrap:wrap; align-items:flex-end; }
.conversation-segment { display:flex; min-width:18px; margin:0 2px 2px; padding:0 2px; box-sizing:border-box; align-items:center; flex-direction:column; border-radius:4px; }
.conversation-segment.target { padding:1px 4px; border-radius:6px; background:#dff5c7; }
.conversation-line.right .conversation-segment.target { color:#529917; }
.conversation-segment.punctuation { min-width:auto; justify-content:flex-end; }
.conversation-pinyin { color:#8c9d82; font-size:10px; line-height:1.4; }
.conversation-line.right .conversation-pinyin { color:rgba(255,255,255,.68); }
.conversation-segment.target .conversation-text { font-weight:800; }
.conversation-text { min-height:22px; font-size:14px; font-weight:500; line-height:1.6; }
.preview-character-grid { z-index:3; width:52%; min-width:0; max-width:194px; height:auto; aspect-ratio:1; margin:-20px auto 8px; box-sizing:border-box; border-color:rgba(82,153,23,.12); border-radius:12px; background:linear-gradient(180deg,#fff,#f7fff2); color:#162b08; font-size:100px; font-weight:500; box-shadow:0 18px 30px rgba(82,153,23,.12); }
.preview-phrases { position:relative; z-index:3; display:flex; flex:1; min-height:0; align-items:center; justify-content:center; margin-top:0; padding:0 0 12px; box-sizing:border-box; gap:0; }
.preview-phrase { width:39%; min-width:0; margin:0 5.5%; padding:6px 8px; border-color:rgba(82,153,23,.16); border-radius:999px; background:linear-gradient(180deg,#ecf9de,#dff5c7); color:#162b08; box-shadow:0 12px 20px rgba(82,153,23,.08); transform:rotate(-2deg); }
.preview-phrase .phrase-segment { min-width:14px; }
.preview-phrase .phrase-segment + .phrase-segment { margin-left:2px; }
.preview-phrase .phrase-pinyin { font-size:8px; }
.preview-phrase .phrase-character { font-size:12px; }
.preview-phrase:nth-child(even) { transform:rotate(1.5deg); }
.preview-overlay { z-index:2; background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(15,15,15,.08)); pointer-events:none; }
.compact-layout .character-section { padding-right:8px; padding-left:8px; }
.compact-layout .character-row { gap:4px; }
.compact-layout .side-tool { max-width:58px; padding:7px 3px; gap:2px; font-size:10px; }
.compact-layout .pronounce-button { padding:6px 10px; font-size:12px; }
.compact-layout .writer-wrap { padding:7px; border-radius:18px; }
@keyframes conversation-up { from { transform:translateY(100%); } to { transform:translateY(0); } }
@keyframes conversation-down { from { transform:translateY(0); } to { transform:translateY(100%); } }
