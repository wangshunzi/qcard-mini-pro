:host {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
}

.flip-bounds {
  width:100%;
  height:100%;
  min-width:0;
  min-height:0;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}
.flip-shell { position:relative; flex:none; overflow:visible; perspective:1800rpx; transform-origin:center; }
.flip-stage { position:relative; width:100%; height:100%; transform:rotateY(0deg); transform-style:preserve-3d; opacity:1; }
.flip-stage.flip-out { transform:rotateY(90deg); opacity:.72; transition:transform 210ms cubic-bezier(.55,.05,.68,.53),opacity 180ms ease; }
.flip-stage.flip-in { animation:flip-in 210ms cubic-bezier(.22,.8,.22,1); }
.flip-face { position:absolute; inset:0; overflow:hidden; border-radius:34rpx; backface-visibility:hidden; box-shadow:0 18rpx 48rpx rgba(33,68,49,.14); }
.preview-mode {
  --qcard-inner-radius: 0rpx;
}
.preview-mode .flip-shell,
.preview-mode .flip-face,
.preview-mode .unsupported {
  border-radius:0;
}
.preview-mode .flip-shell { overflow:hidden; }
.flip-back { transform:none; }
.unsupported { height:100%; display:flex; align-items:center; justify-content:center; border-radius:34rpx; background:#f3f5f2; color:#849089; }
.flip-button { position:absolute; z-index:20; right:16rpx; bottom:16rpx; width:72rpx; min-width:72rpx; height:72rpx; margin:0; padding:0; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#333; background:rgba(255,255,255,.95); box-shadow:0 4rpx 10rpx rgba(0,0,0,.2); font-size:36rpx; line-height:72rpx; }

@keyframes flip-in {
  from { transform:rotateY(-90deg); opacity:.72; }
  to { transform:rotateY(0deg); opacity:1; }
}
