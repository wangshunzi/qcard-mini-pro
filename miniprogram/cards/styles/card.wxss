:host {
  display: block;
  width: 100%;
  height: 100%;
}

.qcard {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--qcard-inner-radius, 34rpx);
  background: var(--color-card);
  color:var(--color-primary);
}

.qcard-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.qcard-content {
  position: relative;
  z-index: 1;
  height: 100%;
  box-sizing: border-box;
  padding: 34rpx;
}

.qcard-title { font-size: 34rpx; font-weight: 800; line-height: 1.25; }
.qcard-subtitle { margin-top: 10rpx; color: rgba(23,51,38,.66); font-size: 24rpx; line-height: 1.5; }
.qcard-panel { border-radius: 28rpx; background: var(--color-surface-translucent); box-shadow: 0 14rpx 36rpx rgba(23,51,38,.12); }
.qcard-button { min-height: 80rpx; display:flex; align-items:center; justify-content:center; border-radius:22rpx; font-size:28rpx; font-weight:700; }
.qcard-disabled { pointer-events: none; }
.qcard-feedback-success { color:var(--color-primary); background:var(--color-success-soft); }
.qcard-feedback-error { color:var(--color-error); background:var(--color-error-soft); }
