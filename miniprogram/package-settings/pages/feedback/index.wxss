.page { min-height: 100vh; padding: 28rpx 30rpx 70rpx; box-sizing: border-box; background: var(--color-card); }
.feedback-mode-switch { height:82rpx; }
.submit-panel, .list-panel, .detail-panel { margin-top: 34rpx; }
.label { display: block; color: var(--color-text); font-size: 24rpx; font-weight: 650; }
.block-label { margin-top: 34rpx; }
.type-grid { margin-top: 16rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.type-option { height: 72rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--color-border); border-radius: 13rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.type-option.active { border-color: var(--color-primary-20); color: var(--color-primary-20); background: var(--color-primary-10); }
.image-picker { width: 178rpx; height: 178rpx; margin-top: 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 13rpx; border: 2rpx dashed var(--color-border); border-radius: 16rpx; color: var(--color-text-secondary); background: var(--color-backdrop); font-size: 20rpx; }
.image-preview-wrap { position: relative; width: 230rpx; height: 230rpx; margin-top: 16rpx; }
.image-preview { width: 100%; height: 100%; border: 1rpx solid var(--color-border); border-radius: 16rpx; }
.remove-image { position: absolute; top: 8rpx; right: 8rpx; width: 52rpx; height: 52rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(15, 15, 15, .64); line-height: 52rpx; }
.textarea-wrap { position: relative; height: 300rpx; margin-top: 16rpx; overflow: hidden; border: 1rpx solid var(--color-border); border-radius: 16rpx; background: var(--color-backdrop); }
.textarea { width: 100%; height: 238rpx; padding: 22rpx; box-sizing: border-box; color: var(--color-text); font-size: 23rpx; line-height: 1.6; }
.content-guidance { position: absolute; right: 18rpx; bottom: 13rpx; left: 18rpx; display: flex; align-items: center; justify-content:flex-end; }
.counter { flex: 0 0 auto; color: var(--color-muted); font-size: 18rpx; }
.input { width: 100%; height: 82rpx; margin-top: 16rpx; padding: 0 22rpx; border: 1rpx solid var(--color-border); border-radius: 16rpx; box-sizing: border-box; color: var(--color-text); background: var(--color-backdrop); font-size: 23rpx; }
.submit { height: 86rpx; margin-top: 34rpx; border-radius: 16rpx; color: var(--color-text-inverse); background: var(--color-primary-20); font-size: 25rpx; font-weight: 650; line-height: 86rpx; }
.submit[disabled] { color: var(--color-text-secondary); background: var(--color-tertiary-10); opacity: 1; }
.submit-hover, .soft-hover { opacity: .74; }
.status-scroll { width: 100%; white-space: nowrap; }
.status-row { display: inline-flex; gap: 13rpx; }
.status-option { height: 58rpx; padding: 0 25rpx; display: flex; align-items: center; border-radius: 999rpx; color: var(--color-text-secondary); background: var(--color-backdrop); font-size: 20rpx; }
.status-option.active { color: var(--color-text-inverse); background: var(--color-primary-20); }
.feedback-list { margin-top: 24rpx; display: flex; flex-direction: column; gap: 14rpx; }
.feedback-item { min-height: 116rpx; padding: 22rpx; box-sizing: border-box; display: flex; align-items: center; gap: 18rpx; border: 1rpx solid var(--color-border); border-radius: 16rpx; background: var(--color-backdrop); }
.feedback-icon { flex: 0 0 auto; }
.feedback-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.feedback-title-row { display: flex; align-items: center; gap: 12rpx; }
.feedback-type { color: var(--color-text); font-size: 23rpx; font-weight: 650; }
.feedback-content { margin-top: 8rpx; overflow: hidden; color: var(--color-text-secondary); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.status-badge { padding: 4rpx 11rpx; border-radius: 999rpx; color:var(--color-warning); background:var(--color-warning-soft); font-size: 17rpx; }
.status-badge.processing { color:var(--color-secondary-20); background:var(--color-info-soft); }
.status-badge.resolved { color:var(--color-primary); background: var(--color-primary-soft); }
.status-badge.closed { color:var(--color-text-secondary); background: var(--color-tertiary-10); }
.item-hover { background: var(--color-tertiary-10); }
.load-more { height: 74rpx; margin-top: 10rpx; border: 1rpx solid var(--color-primary-10); border-radius: 13rpx; color: var(--color-primary-20); background: var(--color-backdrop); font-size: 22rpx; line-height: 72rpx; }
.detail-panel { padding: 26rpx; border: 1rpx solid var(--color-border); border-radius: 16rpx; background: var(--color-backdrop); }
.back-list { margin-bottom: 28rpx; color: var(--color-primary-20); font-size: 22rpx; }
.detail-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.detail-title { color: var(--color-text); font-size: 27rpx; font-weight: 700; }
.detail-content { display: block; margin-top: 26rpx; color: var(--color-text); font-size: 23rpx; line-height: 1.7; white-space: pre-wrap; }
.detail-image { display: block; width: 100%; margin-top: 24rpx; border: 1rpx solid var(--color-border); border-radius: 15rpx; }
.detail-contact, .detail-time { display: block; margin-top: 24rpx; color: var(--color-text-secondary); font-size: 19rpx; }
.reply { margin-top: 28rpx; padding: 22rpx; display: flex; flex-direction: column; border-radius: 14rpx; background: var(--color-primary-10); }
.reply-label { color: var(--color-primary-20); font-size: 19rpx; font-weight: 650; }
.reply-content { margin-top: 13rpx; color: var(--color-text); font-size: 22rpx; line-height: 1.65; }
.state { min-height: 430rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.spinner { width: 34rpx; height: 34rpx; border: 4rpx solid var(--color-border); border-top-color: var(--color-primary); border-radius: 50%; animation: spin .75s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
