<page-meta page-style="{{themePageStyle}}"></page-meta>
<view class="page safe-bottom theme-{{themeMode}}">
  <immersive-nav title="主题设置" back="{{true}}" border="{{true}}" />
  <view class="section-heading">
    <text class="section-title">主题模式</text>
    <text class="section-subtitle">切换浅色 / 暗黑，或跟随系统</text>
  </view>
  <view class="theme-list appearance-list">
    <button wx:for="{{appearanceOptions}}" wx:key="key"
      class="theme-row {{themePreference === item.key ? 'selected' : ''}}"
      data-mode="{{item.key}}" bindtap="chooseAppearance" hover-class="theme-hover">
      <view class="row-main">
        <ui-icon name="{{item.icon}}" size="{{34}}" color="var(--color-text-secondary)" />
        <view class="theme-copy">
          <text class="theme-name">{{item.title}}</text>
          <text class="theme-description">{{item.description}}</text>
        </view>
      </view>
      <ui-icon wx:if="{{themePreference === item.key}}" name="check" size="{{32}}" color="var(--color-primary)" />
    </button>
  </view>

  <view class="section-heading application-heading">
    <text class="section-title">应用主题</text>
    <text class="section-subtitle">选择卡片与界面的配色风格</text>
  </view>
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{error}}" class="state">
    <ui-icon name="alert-circle-outline" size="{{76}}" color="var(--color-error)" />
    <text>{{error}}</text>
    <button bindtap="load">重新加载</button>
  </view>
  <block wx:else>
    <view wx:if="{{currentTheme}}" class="current-theme">
      <view class="current-icon"><ui-icon name="palette-outline" size="{{34}}" color="var(--color-primary)" /></view>
      <view class="current-copy">
        <text class="current-title">当前主题：{{currentTheme.name}}</text>
        <text class="current-description">{{currentTheme.description || '叩咔主题背景'}}</text>
      </view>
    </view>
    <view wx:if="{{themes.length}}" class="theme-list">
      <button wx:for="{{themes}}" wx:key="id" class="theme-row {{currentThemeId === item.id ? 'selected' : ''}}"
        data-id="{{item.id}}" bindtap="chooseTheme" hover-class="theme-hover" disabled="{{selectingId}}">
        <view class="row-main">
          <ui-icon name="palette-outline" size="{{34}}" color="var(--color-text-secondary)" />
          <view class="theme-copy">
            <view class="theme-name-line">
              <text class="theme-name">{{item.name}}</text>
              <text wx:if="{{item.isDefault}}" class="default-tag">默认</text>
            </view>
            <text class="theme-description">{{item.description || '叩咔主题背景'}}</text>
          </view>
        </view>
        <ui-icon wx:if="{{currentThemeId === item.id}}" name="check" size="{{32}}" color="var(--color-primary)" />
        <text wx:elif="{{selectingId === item.id}}" class="switching">切换中</text>
      </button>
    </view>
    <view wx:else class="state">
      <ui-icon name="palette-outline" size="{{78}}" color="var(--color-text-secondary)" />
      <text class="empty-title">暂无可用主题</text>
      <text>请联系管理员添加更多主题选项</text>
    </view>
  </block>
</view>
