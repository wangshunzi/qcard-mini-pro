.page { min-height:100vh; padding:38rpx 32rpx; box-sizing:border-box; background:#f7f8f6; }
.settings-section { overflow:hidden; border-radius:18rpx; background:#fff; box-shadow:0 2rpx 8rpx rgba(0,0,0,.06); }
.delete-entry { width:100%; min-height:104rpx; margin:0; padding:0 30rpx; display:flex; align-items:center; justify-content:space-between; border:0; border-radius:0; color:#d35f56; background:#fff; line-height:1.4; }
.entry-main { display:flex; align-items:center; gap:23rpx; }
.entry-main text { font-size:25rpx; font-weight:500; }
.entry-hover { background:#fff4f2; }
.page-tip { display:block; padding:16rpx 8rpx; color:var(--color-text-secondary); font-size:20rpx; line-height:1.6; }
.dialog-root { position:fixed; z-index:999; inset:0; display:flex; align-items:center; justify-content:center; padding:32rpx; box-sizing:border-box; }
.dialog-backdrop { position:absolute; inset:0; background:rgba(0,0,0,.45); backdrop-filter:blur(4rpx); }
.dialog { position:relative; width:100%; max-width:670rpx; padding:38rpx; box-sizing:border-box; border:1rpx solid var(--color-border); border-radius:24rpx; background:#fff; box-shadow:0 18rpx 50rpx rgba(0,0,0,.22); animation:dialog-in .18s ease-out; }
.dialog-close { position:absolute; top:20rpx; right:20rpx; width:58rpx; height:58rpx; margin:0; padding:0; display:flex; align-items:center; justify-content:center; border:0; border-radius:50%; background:transparent; line-height:58rpx; }
.dialog-title { display:block; padding-right:60rpx; color:var(--color-text); font-size:34rpx; font-weight:750; }
.dialog-description { display:block; margin-top:13rpx; color:var(--color-text-secondary); font-size:23rpx; line-height:1.55; }
.label { display:block; margin-top:26rpx; color:var(--color-text-secondary); font-size:21rpx; }
.math { margin-top:13rpx; padding:23rpx; border:1rpx solid rgba(82,153,23,.28); border-radius:18rpx; color:var(--color-text); background:rgba(82,153,23,.08); font-size:38rpx; font-weight:800; text-align:center; }
.answer { height:78rpx; margin-top:18rpx; border:1rpx solid var(--color-border); border-radius:17rpx; background:#fff; font-size:29rpx; text-align:center; }
.error { margin-top:12rpx; color:var(--color-error); font-size:23rpx; text-align:center; }
.delete-button,.cancel-button { height:84rpx; margin-top:28rpx; border-radius:19rpx; font-size:25rpx; font-weight:700; line-height:84rpx; }
.delete-button { color:#fff; background:var(--color-error); }
.delete-button[disabled] { opacity:.45; }
.cancel-button { margin-top:13rpx; color:var(--color-text); background:var(--color-backdrop); }
@keyframes dialog-in { from { opacity:0; transform:scale(.94); } to { opacity:1; transform:scale(1); } }
