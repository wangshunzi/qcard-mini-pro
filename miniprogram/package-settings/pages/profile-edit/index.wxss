.page { min-height:100vh; background:var(--color-background); }
.nav-save { width:auto; height:var(--immersive-control-height); margin:0; padding:0 23rpx; border:1rpx solid rgba(82,153,23,.16); border-radius:999rpx; color:var(--color-primary); background:var(--color-primary-soft); box-shadow:0 5rpx 15rpx rgba(54,91,45,.08); font-size:23rpx; font-weight:700; line-height:var(--immersive-control-height); }
.nav-save[disabled] { border-color:#e2e6e2; color:var(--color-text-muted); background:var(--color-surface-soft); box-shadow:none; }
.avatar-area { padding:44rpx 32rpx 30rpx; display:flex; flex-direction:column; align-items:center; color:var(--color-text-secondary); font-size:21rpx; }
.avatar { width:156rpx; height:156rpx; margin-bottom:16rpx; border:6rpx solid #fff; border-radius:50%; background:var(--color-card); box-shadow:0 8rpx 24rpx rgba(0,0,0,.12); }
.change-avatar { width:auto; height:54rpx; margin:0; padding:0 18rpx; border:0; color:var(--color-text-secondary); background:transparent; font-size:22rpx; line-height:54rpx; }
.form { margin:8rpx 32rpx 0; overflow:hidden; border:1rpx solid var(--color-border); border-radius:24rpx; background:var(--color-card); }
.row { min-height:100rpx; padding:0 25rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; border-bottom:1rpx solid #edf0ed; color:var(--color-text); font-size:25rpx; }
.row:last-child { border-bottom:0; }
.row > text:first-child { font-weight:650; }
.row input { min-width:0; flex:1; text-align:right; }
.row > view { display:flex; align-items:center; gap:8rpx; color:var(--color-text-secondary); }
.bio-row { padding:24rpx 25rpx 26rpx; }
.bio-label { display:flex; align-items:center; justify-content:space-between; }
.bio-label text:first-child { color:var(--color-text); font-size:25rpx; font-weight:650; }
.bio-label text:last-child { color:var(--color-text-secondary); font-size:19rpx; }
.bio-row textarea { width:100%; height:148rpx; margin-top:17rpx; padding:18rpx; box-sizing:border-box; border:1rpx solid var(--color-border); border-radius:17rpx; color:var(--color-text); background:var(--color-backdrop); font-size:23rpx; line-height:1.5; }
.tappable { transition:background .15s ease; }
.state { min-height:70vh; display:flex; align-items:center; justify-content:center; color:var(--color-text-secondary); }
.avatar-drawer-root { position:fixed; z-index:999; inset:0; }
.avatar-drawer-backdrop { position:absolute; inset:0; background:rgba(13,32,23,.56); backdrop-filter:blur(8rpx); animation:avatar-drawer-fade-in .22s ease-out both; }
.avatar-drawer { position:absolute; right:0; bottom:0; left:0; max-height:78vh; display:flex; flex-direction:column; overflow:hidden; border-radius:30rpx 30rpx 0 0; background:var(--color-card); animation:avatar-drawer-in .22s ease-out; }
.avatar-drawer.dragging { animation:none; transform:translateY(var(--avatar-drawer-drag-offset)); transition:none; }
.avatar-drawer.drag-settling { animation:none; transform:translateY(var(--avatar-drawer-drag-offset)); transition:transform .22s ease-in-out; }
.avatar-drawer-drag-area { flex:none; }
.drawer-handle { width:92rpx; height:8rpx; margin:18rpx auto 14rpx; flex:none; border-radius:999rpx; background:var(--color-surface-soft); }
.drawer-heading { padding:8rpx 34rpx 24rpx; display:flex; flex-direction:column; }
.drawer-heading text:first-child { color:var(--color-text); font-size:34rpx; font-weight:800; }
.drawer-heading text:last-child { margin-top:7rpx; color:var(--color-text-secondary); font-size:21rpx; }
.avatar-grid-scroll { max-height:62vh; }
.avatar-grid { padding:0 30rpx 46rpx; display:grid; grid-template-columns:repeat(3,1fr); gap:20rpx; }
.avatar-option { min-width:0; margin:0; padding:12rpx; display:flex; flex-direction:column; align-items:center; border:3rpx solid var(--color-border); border-radius:22rpx; background:var(--color-card); }
.avatar-image-square { position:relative; width:100%; height:0; padding-top:100%; flex:none; overflow:hidden; border-radius:15rpx; background:var(--color-backdrop); }
.avatar-image-square image { position:absolute; inset:0; display:block; width:100%; height:100%; }
.avatar-option text { width:100%; margin-top:9rpx; overflow:hidden; color:var(--color-text-secondary); font-size:19rpx; line-height:1.3; text-align:center; text-overflow:ellipsis; white-space:nowrap; }
.avatar-option.selected { border-color:var(--color-primary); background:var(--color-primary-10); box-shadow:0 6rpx 18rpx rgba(82,153,23,.1); }
@keyframes avatar-drawer-in { from { transform:translateY(100%); } to { transform:translateY(0); } }
@keyframes avatar-drawer-out { from { transform:translateY(0); } to { transform:translateY(100%); } }
@keyframes avatar-drawer-fade-in { from { opacity:0; } to { opacity:1; } }
@keyframes avatar-drawer-fade-out { from { opacity:1; } to { opacity:0; } }
.avatar-drawer-root.closing .avatar-drawer-backdrop { animation:avatar-drawer-fade-out .22s ease-in both; }
.avatar-drawer-root.closing .avatar-drawer { animation:avatar-drawer-out .22s ease-in both; }
.avatar-drawer-root.closing .avatar-drawer.drag-settling { animation:none; }
