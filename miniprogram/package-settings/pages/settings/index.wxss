.page {
  min-height: 100vh;
  padding: 38rpx 32rpx 52rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #f7f8f6;
}

.group {
  overflow: hidden;
  border-radius: 18rpx;
  background: var(--color-backdrop);
}

.row {
  min-height: 104rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #e1e5e1;
}

.contact-row {
  width: 100%;
  margin: 0;
  color: inherit;
  background: var(--color-backdrop);
  line-height: 1.5;
  text-align: left;
}

.row:last-child {
  border-bottom: 0;
}

.row-main {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 23rpx;
}

.row-main text {
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 500;
}

.row-hover {
  background: #f0f3ef;
}

.logout-button {
  height: 88rpx;
  margin: auto 0 0;
  border: 1rpx solid rgba(215, 220, 215, .45);
  border-radius: 18rpx;
  color: var(--color-text);
  background: var(--color-backdrop);
  font-size: 24rpx;
  font-weight: 550;
  line-height: 86rpx;
}

.legal-links {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 44rpx;
}

.legal-links button {
  width: auto;
  height: auto;
  margin: 0;
  padding: 4rpx;
  color: var(--color-text-secondary);
  background: transparent;
  font-size: 20rpx;
  line-height: 1.5;
}

.version {
  margin-top: 16rpx;
  color: var(--color-muted);
  text-align: center;
  font-size: 18rpx;
}
