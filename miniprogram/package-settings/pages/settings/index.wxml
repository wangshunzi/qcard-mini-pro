<page-meta page-style="{{themePageStyle}}"></page-meta>
<view class="page safe-bottom theme-{{themeMode}}">
  <immersive-nav title="设置" back="{{true}}" border="{{true}}" />
  <view class="group">
    <view class="row tappable" bindtap="openAccount" hover-class="row-hover">
      <view class="row-main"><ui-icon name="shield-account-outline" size="{{35}}" color="var(--color-text-secondary)" /><text>账号与安全</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="var(--color-text-muted)" />
    </view>
    <view class="row tappable" bindtap="openChallengeConfig" hover-class="row-hover">
      <view class="row-main"><ui-icon name="account-outline" size="{{35}}" color="var(--color-text-secondary)" /><text>学习定制</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="var(--color-text-muted)" />
    </view>
    <view class="row tappable" bindtap="openTheme" hover-class="row-hover">
      <view class="row-main"><ui-icon name="palette-outline" size="{{35}}" color="var(--color-text-secondary)" /><text>主题模式</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="var(--color-text-muted)" />
    </view>
    <view class="row tappable" bindtap="openFeedback" hover-class="row-hover">
      <view class="row-main"><ui-icon name="message-text-outline" size="{{35}}" color="var(--color-text-secondary)" /><text>意见反馈</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="var(--color-text-muted)" />
    </view>
    <view class="row tappable" bindtap="openVirtualOrders" hover-class="row-hover">
      <view class="row-main"><ui-icon name="file-document-outline" size="{{35}}" color="var(--color-text-secondary)" /><text>购买记录</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="var(--color-text-muted)" />
    </view>
    <button class="row tappable contact-row" open-type="contact" hover-class="row-hover">
      <view class="row-main"><ui-icon name="account-group-outline" size="{{35}}" color="var(--color-text-secondary)" /><text>帮助与客服</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="var(--color-text-muted)" />
    </button>
  </view>
  <button class="logout-button" bindtap="logout">退出登录</button>
  <view class="legal-links">
    <button bindtap="openAgreement">《用户协议》</button>
    <button bindtap="openPrivacy">《隐私政策》</button>
  </view>
  <view class="version">叩咔 AI · {{version}}</view>
  <button
    class="filing-link"
    bindtap="openFilingQuery"
    aria-label="查询小程序备案信息 {{filingNumber}}"
    hover-class="filing-link-hover"
  >{{filingNumber}}</button>
</view>
