<view class="page safe-bottom">
  <immersive-nav title="设置" back="{{true}}" border="{{true}}" />
  <view class="group">
    <view class="row tappable" bindtap="openAccount" hover-class="row-hover">
      <view class="row-main"><ui-icon name="shield-account-outline" size="{{35}}" color="#657065" /><text>账号与安全</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="#a9a9a9" />
    </view>
    <view class="row tappable" bindtap="openChallengeConfig" hover-class="row-hover">
      <view class="row-main"><ui-icon name="account-outline" size="{{35}}" color="#657065" /><text>学习定制</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="#a9a9a9" />
    </view>
    <view class="row tappable" bindtap="openTheme" hover-class="row-hover">
      <view class="row-main"><ui-icon name="palette-outline" size="{{35}}" color="#657065" /><text>主题模式</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="#a9a9a9" />
    </view>
    <view class="row tappable" bindtap="openFeedback" hover-class="row-hover">
      <view class="row-main"><ui-icon name="message-text-outline" size="{{35}}" color="#657065" /><text>意见反馈</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="#a9a9a9" />
    </view>
    <view class="row tappable" bindtap="openVirtualOrders" hover-class="row-hover">
      <view class="row-main"><ui-icon name="file-document-outline" size="{{35}}" color="#657065" /><text>购买记录</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="#a9a9a9" />
    </view>
    <button class="row tappable contact-row" open-type="contact" hover-class="row-hover">
      <view class="row-main"><ui-icon name="account-group-outline" size="{{35}}" color="#657065" /><text>帮助与客服</text></view>
      <ui-icon name="chevron-right" size="{{30}}" color="#a9a9a9" />
    </button>
  </view>
  <button class="logout-button" bindtap="logout">退出登录</button>
  <view class="legal-links">
    <button bindtap="openAgreement">《用户协议》</button>
    <button bindtap="openPrivacy">《隐私政策》</button>
  </view>
  <view class="version">叩咔 AI · {{version}}</view>
</view>
