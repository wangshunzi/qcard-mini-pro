.page { min-height:100vh; padding:26rpx 28rpx 56rpx; box-sizing:border-box; background:#f5f7f4; }
.notice { margin-bottom:22rpx; padding:20rpx 22rpx; display:flex; align-items:center; gap:13rpx; border:1rpx solid #dce8d8; border-radius:18rpx; color:#48604d; background:#edf6e9; font-size:21rpx; line-height:1.45; }
.state { min-height:440rpx; padding:56rpx 34rpx; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:18rpx; color:#778078; font-size:22rpx; line-height:1.5; text-align:center; }
.state-title { color:#344038; font-size:28rpx; font-weight:750; }
.state button { width:auto; min-width:170rpx; height:64rpx; margin:8rpx 0 0; padding:0 28rpx; border-radius:999rpx; color:#fff; background:#529917; font-size:22rpx; line-height:64rpx; }
.loading-dot { width:22rpx; height:22rpx; border-radius:50%; background:#529917; animation:pulse 1.1s ease-in-out infinite; }
.order-list { display:flex; flex-direction:column; gap:18rpx; }
.inline-error { padding:18rpx 20rpx; display:flex; align-items:center; justify-content:space-between; gap:16rpx; border:1rpx solid #efd6c9; border-radius:16rpx; color:#a75032; background:#fff5ef; font-size:20rpx; }
.inline-error text { min-width:0; flex:1; }
.inline-error button { width:auto; min-width:126rpx; height:52rpx; margin:0; padding:0 18rpx; flex:none; border:1rpx solid rgba(189,85,79,.35); border-radius:999rpx; color:#a75032; background:#fff; font-size:19rpx; line-height:50rpx; }
.order-card { padding:24rpx; border:1rpx solid #e1e6df; border-radius:22rpx; background:#fff; box-shadow:0 7rpx 20rpx rgba(29,49,35,.04); }
.order-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; }
.order-title-copy { min-width:0; display:flex; flex-direction:column; gap:7rpx; }
.order-title { overflow:hidden; color:#28332b; font-size:26rpx; font-weight:780; text-overflow:ellipsis; white-space:nowrap; }
.order-time { color:#899189; font-size:19rpx; }
.order-price { flex:none; color:#d96b28; font-size:28rpx; font-weight:800; }
.order-price text { margin-right:2rpx; font-size:18rpx; }
.status-grid { margin-top:22rpx; display:grid; grid-template-columns:repeat(3,1fr); gap:10rpx; }
.axis { padding:15rpx 8rpx; display:flex; align-items:center; flex-direction:column; gap:6rpx; border-radius:14rpx; background:#f5f7f4; }
.axis-label { color:#899088; font-size:18rpx; }
.axis-value { font-size:21rpx; font-weight:700; }
.axis-value.success { color:#529917; }
.axis-value.pending { color:#b47713; }
.axis-value.failed { color:#bd554f; }
.axis-value.muted { color:#778079; }
.order-foot { min-height:54rpx; margin-top:18rpx; padding-top:16rpx; display:flex; align-items:center; justify-content:space-between; gap:18rpx; border-top:1rpx solid #edf0ec; }
.order-no { min-width:0; overflow:hidden; color:#919791; font-size:17rpx; text-overflow:ellipsis; white-space:nowrap; }
.refresh-button { width:auto; min-width:128rpx; height:52rpx; margin:0; padding:0 20rpx; flex:none; border:1rpx solid rgba(82,153,23,.4); border-radius:999rpx; color:#529917; background:#fff; font-size:19rpx; line-height:50rpx; }
.arrived { flex:none; color:#529917; font-size:20rpx; font-weight:700; }
.list-tip { padding:24rpx 0 8rpx; color:#979e98; font-size:19rpx; text-align:center; }
@keyframes pulse { 0%,100% { opacity:.4; transform:scale(.78); } 50% { opacity:1; transform:scale(1.12); } }
