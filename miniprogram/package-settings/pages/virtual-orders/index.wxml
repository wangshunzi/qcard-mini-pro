<page-meta page-style="{{themePageStyle}}"></page-meta>
<view class="page safe-bottom theme-{{themeMode}}">
  <immersive-nav title="购买记录" back="{{true}}" border="{{true}}" />

  <view class="notice">
    <ui-icon name="shield-key-outline" size="{{31}}" color="var(--color-primary)" />
    <text>支付成功且权益发放成功，才表示咔豆或 VIP 已到账</text>
  </view>

  <view wx:if="{{loading && !items.length}}" class="state">
    <view class="loading-dot"></view>
    <text>正在加载购买记录…</text>
  </view>

  <view wx:elif="{{error && !items.length}}" class="state error-state">
    <ui-icon name="alert-circle-outline" size="{{66}}" color="var(--color-error)" />
    <text class="state-title">加载失败</text>
    <text>{{error}}</text>
    <button data-reset="{{true}}" bindtap="retryLoad">重试</button>
  </view>

  <view wx:elif="{{!items.length}}" class="state">
    <ui-icon name="file-document-outline" size="{{74}}" color="var(--color-text-secondary)" />
    <text class="state-title">暂无购买记录</text>
    <text>购买咔豆或 VIP 后，订单与到账状态会显示在这里</text>
  </view>

  <view wx:else class="order-list">
    <view wx:if="{{error}}" class="inline-error">
      <text>{{error}}</text>
      <button bindtap="retryLoad">立即重试</button>
    </view>
    <view wx:for="{{items}}" wx:key="orderNo" class="order-card">
      <view class="order-head">
        <view class="order-title-copy">
          <text class="order-title">{{item.productName}}</text>
          <text class="order-time">{{item.createdAtText}}</text>
        </view>
        <view class="order-price"><text>¥</text>{{item.displayPrice}}</view>
      </view>

      <view class="status-grid">
        <view class="axis">
          <text class="axis-label">支付</text>
          <text class="axis-value {{item.paymentTone}}">{{item.paymentLabel}}</text>
        </view>
        <view class="axis">
          <text class="axis-label">权益</text>
          <text class="axis-value {{item.fulfillmentTone}}">{{item.fulfillmentLabel}}</text>
        </view>
        <view class="axis">
          <text class="axis-label">退款</text>
          <text class="axis-value {{item.refundTone}}">{{item.refundLabel}}</text>
        </view>
      </view>

      <view class="order-foot">
        <text class="order-no">订单号 {{item.orderNo}}</text>
        <button
          wx:if="{{item.processing}}"
          class="refresh-button"
          data-order-no="{{item.orderNo}}"
          loading="{{refreshingOrderNo === item.orderNo}}"
          disabled="{{refreshingOrderNo}}"
          bindtap="refreshOrder"
        >刷新状态</button>
        <text wx:elif="{{item.completed}}" class="arrived">已到账</text>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="list-tip">加载更多…</view>
    <view wx:elif="{{page >= totalPages}}" class="list-tip">已显示全部 {{total}} 笔记录</view>
  </view>
</view>
