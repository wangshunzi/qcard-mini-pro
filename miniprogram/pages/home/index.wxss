.home-page { min-height:100vh; box-sizing:border-box; background:var(--color-background); }
.startup-loading-screen { position:fixed; z-index:980; inset:0; overflow:hidden; box-sizing:border-box; background:var(--color-background); pointer-events:none; }
.startup-loading-nav { position:absolute; z-index:2; top:0; right:0; left:0; height:var(--immersive-content-safe-top); padding:calc(var(--immersive-content-safe-top) - 72rpx) 32rpx 0; box-sizing:border-box; display:flex; align-items:flex-start; justify-content:space-between; }
.startup-loading-pill { width:118rpx; height:56rpx; border-radius:999rpx; background:var(--color-glass); box-shadow:var(--shadow-control); }
.startup-loading-pill.short { width:92rpx; }
.startup-loading-hero { height:468rpx; padding-top:var(--immersive-content-safe-top); box-sizing:border-box; display:flex; flex-direction:column; align-items:center; gap:13rpx; background:linear-gradient(160deg,var(--color-secondary-10),var(--color-background-elevated)); }
.startup-loading-copy { width:180rpx; height:24rpx; border-radius:999rpx; background:var(--color-skeleton-highlight); opacity:.82; }
.startup-loading-copy.short { width:126rpx; height:20rpx; opacity:.62; }
.startup-loading-panel { position:relative; margin:-48rpx 16rpx 0; padding:30rpx 24rpx 40rpx; border:1rpx solid var(--color-border); border-radius:28rpx 28rpx 0 0; background:var(--color-card); box-shadow:var(--shadow-card); }
.startup-loading-row { display:flex; align-items:center; gap:18rpx; }
.startup-loading-avatar { width:92rpx; height:92rpx; flex:none; border-radius:24rpx; background:var(--color-skeleton-base); }
.startup-loading-lines { min-width:0; flex:1; display:flex; flex-direction:column; gap:13rpx; }
.startup-loading-lines view { height:20rpx; border-radius:999rpx; background:var(--color-skeleton-base); }
.startup-loading-lines view:last-child { width:62%; }
.startup-loading-action { width:70rpx; height:70rpx; flex:none; border-radius:50%; background:var(--color-skeleton-highlight); }
.startup-loading-card { height:150rpx; margin-top:22rpx; border-radius:25rpx; background:linear-gradient(90deg,var(--color-skeleton-base),var(--color-skeleton-highlight),var(--color-skeleton-base)); animation:pulse 1.25s ease-in-out infinite alternate; }
.welcome-card { position:relative; height:468rpx; overflow:hidden; color:var(--color-text-inverse); background:linear-gradient(155deg,#79a080,#295d44); background-size:cover; background-position:bottom center; }
.welcome-shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(0,0,0,.12),rgba(0,0,0,.02) 55%,rgba(0,0,0,.16)); }
.level-entry,.balance-entry { height:var(--immersive-control-height); box-sizing:border-box; display:flex; align-items:center; border:var(--immersive-control-border); border-radius:999rpx; background:var(--immersive-control-background); box-shadow:var(--immersive-control-shadow); color:var(--color-text); backdrop-filter:blur(18rpx); transition:opacity .15s ease,transform .15s ease,box-shadow .15s ease; }
.level-entry { padding:7rpx 18rpx 7rpx 7rpx; gap:12rpx; }
.top-avatar { width:56rpx; height:56rpx; border:1rpx solid rgba(82,153,23,.16); box-sizing:border-box; border-radius:50%; background:var(--color-card); }
.level-copy { min-width:102rpx; font-size:21rpx; font-weight:700; }
.level-progress { width:102rpx; height:5rpx; margin-top:5rpx; overflow:hidden; border-radius:999rpx; background:var(--color-surface-soft); }
.level-progress view { height:100%; border-radius:999rpx; background:var(--color-primary); }
.balance-entry { padding:0 21rpx; gap:9rpx; font-size:23rpx; font-weight:750; }
.soft-hover { opacity:.8; }
.welcome-copy { position:absolute; z-index:1; top:var(--immersive-content-safe-top); right:0; left:0; display:flex; flex-direction:column; align-items:center; color:var(--color-text-inverse); font-size:27rpx; font-weight:650; text-shadow:0 2rpx 8rpx rgba(0,0,0,.72); }
.welcome-name { display:block; max-width:calc(100% - 190rpx); margin-top:7rpx; overflow:hidden; color:#fff; background:transparent; font-size:34rpx; font-weight:900; letter-spacing:.5rpx; line-height:1.2; text-align:center; text-overflow:ellipsis; text-shadow:-2rpx -2rpx 2rpx rgba(0,0,0,.9),2rpx -2rpx 2rpx rgba(0,0,0,.9),-2rpx 2rpx 2rpx rgba(0,0,0,.9),2rpx 2rpx 2rpx rgba(0,0,0,.9),0 4rpx 12rpx rgba(0,0,0,.95); white-space:nowrap; }
.challenge-card { position:relative; z-index:2; margin:-48rpx 16rpx 0; padding:30rpx 0 28rpx; overflow:hidden; border:1rpx solid var(--color-border); border-radius:28rpx 28rpx 0 0; background:var(--color-card); box-shadow:var(--shadow-card); }
.challenge-main { padding:0 24rpx; display:flex; align-items:center; justify-content:space-between; }
.challenge-summary { display:flex; align-items:center; gap:16rpx; }
.today-icon { width:112rpx; height:112rpx; flex:none; }
.challenge-copy { min-width:116rpx; display:flex; flex-direction:column; }
.challenge-count { display:flex; align-items:baseline; color:var(--color-text); white-space:nowrap; }
.challenge-count text { font-size:30rpx; font-weight:800; line-height:1; }
.challenge-count .challenge-count-divider { padding:0 7rpx; color:var(--color-text-secondary); font-size:21rpx; font-weight:400; }
.challenge-label { margin-top:2rpx; color:var(--color-text-secondary); font-size:21rpx; font-weight:600; }
.challenge-start { width:82rpx; height:82rpx; padding:6rpx; box-sizing:border-box; border-radius:50%; transition:transform .15s ease,opacity .15s ease; }
.challenge-start > view { width:100%; height:100%; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--color-card); box-shadow:0 4rpx 12rpx rgba(0,0,0,.08); }
.challenge-carousel { width:100%; margin-top:22rpx; white-space:nowrap; }
.challenge-carousel-inner { display:inline-flex; padding:0 16rpx 8rpx; gap:9rpx; }
.challenge-preview { position:relative; width:250rpx; height:444.44rpx; flex:none; overflow:hidden; border:2rpx solid var(--color-border); border-radius:15rpx; background:var(--color-surface-soft); box-shadow:0 4rpx 14rpx rgba(0,0,0,.12); transition:transform .15s ease,opacity .15s ease; --qcard-preview-radius:15rpx; }
.challenge-preview.completed { border-color:var(--color-success); }
.challenge-renderer { display:block; width:100%; height:100%; }
.challenge-preview-hover { opacity:.78; transform:scale(.97); }
.complete-mark { position:absolute; top:10rpx; right:10rpx; width:38rpx; height:38rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--color-success); box-shadow:0 3rpx 9rpx rgba(0,0,0,.16); }
.section { padding:0 16rpx; margin-top:40rpx; }
.section.private-face-section { padding-right:32rpx; padding-left:32rpx; }
.section-head { padding:0 2rpx; margin-bottom:20rpx; display:flex; align-items:flex-end; justify-content:space-between; gap:20rpx; }
.section-title { display:block; color:var(--color-text); font-size:31rpx; font-weight:800; }
.section-subtitle { display:block; margin-top:5rpx; color:var(--color-text-secondary); font-size:21rpx; }
.section-more { flex:none; color:var(--color-primary); font-size:23rpx; }
.card-row { width:100%; white-space:nowrap; }
.card-row-inner { display:inline-flex; align-items:flex-start; padding:2rpx 4rpx 12rpx; gap:18rpx; }
.study-list { display:flex; flex-direction:column; gap:20rpx; }
.promotion-title,.promotion-meta { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.private-face-grid { display:grid; grid-template-columns:1fr 1fr; align-items:start; gap:22rpx; }
.promotion-card { width:236rpx; flex:none; }
.promotion-cover { width:236rpx; height:286rpx; border-radius:25rpx; background:var(--color-surface-soft); box-shadow:0 8rpx 22rpx rgba(0,0,0,.08); }
.promotion-title { margin-top:12rpx; color:var(--color-text); font-size:25rpx; font-weight:700; }
.promotion-meta { margin-top:5rpx; color:var(--color-text-secondary); font-size:19rpx; }
.compact-empty,.state-view { display:flex; flex-direction:column; align-items:center; justify-content:center; color:var(--color-text-secondary); text-align:center; }
.compact-empty { min-height:480rpx; gap:14rpx; }
.compact-empty.recent-empty { min-height:480rpx; }
.compact-empty view { display:flex; gap:12rpx; }
.compact-empty button,.state-view button { height:58rpx; margin:0; padding:0 26rpx; border:1rpx solid var(--color-primary); border-radius:999rpx; color:var(--color-primary); background:var(--color-card); font-size:21rpx; line-height:56rpx; }
.state-view { min-height:520rpx; padding:40rpx; gap:13rpx; }
.state-title { color:var(--color-text); font-size:28rpx; font-weight:750; }
.state-copy { font-size:22rpx; }
.state-button-hover { opacity:.75; }
.loading-list { padding:40rpx 16rpx; display:flex; flex-direction:column; gap:22rpx; }
.skeleton { height:150rpx; border-radius:25rpx; background:linear-gradient(90deg,var(--color-skeleton-base),var(--color-skeleton-highlight),var(--color-skeleton-base)); animation:pulse 1.25s ease-in-out infinite alternate; }
@keyframes pulse { from { opacity:.58; } to { opacity:1; } }
