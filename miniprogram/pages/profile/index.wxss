.profile-page {
  min-height: 100vh;
  background: var(--color-background);
}

.profile-header {
  position: relative;
  min-height: 650rpx;
  padding: var(--immersive-content-safe-top) 32rpx 64rpx;
  box-sizing: border-box;
  color: var(--color-tertiary-30);
  background: linear-gradient(145deg, #dcecd9, #f2e6b7);
  background-size: cover;
  background-position: bottom center;
}

.profile-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, .03), rgba(255, 255, 255, .12));
}

.settings-button {
  width: var(--immersive-control-height);
  height: var(--immersive-control-height);
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--immersive-control-border);
  border-radius: 50%;
  background: var(--immersive-control-background);
  box-shadow: var(--immersive-control-shadow);
  line-height: 1;
  backdrop-filter: blur(18rpx);
}

.profile-main {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  padding-right: 76rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap { position: relative; flex: 0 0 auto; }

.avatar {
  width: 96rpx;
  height: 96rpx;
  border: 2rpx solid rgba(15, 15, 15, .1);
  border-radius: 50%;
  background: #fff;
}

.level-badge {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  padding: 2rpx 11rpx;
  border-radius: 999rpx;
  color: #fff;
  background: var(--color-secondary-20);
  font-size: 18rpx;
  white-space: nowrap;
  transform: translateX(-50%);
}

.profile-copy { min-width: 0; flex: 1; }
.name-row, .id-row { display: flex; align-items: center; gap: 11rpx; }

.name {
  overflow: hidden;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-badge {
  padding: 3rpx 11rpx 3rpx 8rpx;
  display: flex;
  align-items: center;
  gap: 3rpx;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(135deg, #ffb300, #f28a00);
  font-size: 18rpx;
  font-weight: 700;
}
.vip-badge-hover { opacity: .78; transform: scale(.96); }

.id-row { margin-top: 9rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.id-label { font-weight: 650; }

.stats-row {
  position: relative;
  z-index: 1;
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 26rpx;
}

.stats { min-width: 0; display: flex; align-items: center; gap: 34rpx; }
.stat { display: flex; flex-direction: column; align-items: center; }
.stat-value { color: var(--color-text); font-size: 25rpx; font-weight: 700; white-space: nowrap; }
.stat-label { margin-top: 4rpx; color: var(--color-text-secondary); font-size: 19rpx; }

.edit-button {
  width: auto;
  height: 54rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid var(--color-text-secondary);
  border-radius: 999rpx;
  color: var(--color-text-secondary);
  background: transparent;
  font-size: 20rpx;
  line-height: 52rpx;
}

.quick-scroll {
  position: relative;
  z-index: 1;
  width: calc(100% + 64rpx);
  margin: 34rpx -32rpx 0;
  white-space: nowrap;
}

.quick-row { display: inline-flex; padding: 0 16rpx; gap: 16rpx; }

.quick-card {
  width: 282rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, .68);
  box-shadow: 0 4rpx 14rpx rgba(26, 46, 32, .05);
  backdrop-filter: blur(10rpx);
}

.quick-title { color: var(--color-primary-30); font-size: 24rpx; font-weight: 650; line-height: 1; }
.quick-subtitle { margin-top: 15rpx; color: var(--color-text-secondary); font-size: 20rpx; line-height: 1; }
.quick-hover, .soft-hover { opacity: .72; }

.profile-content {
  position: relative;
  z-index: 3;
  min-height: 600rpx;
  margin-top: -32rpx;
  padding-bottom: 24rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
  overflow: hidden;
}

.vip-upsell-banner {
  position: relative;
  z-index: 5;
  min-height: 112rpx;
  margin: 18rpx 32rpx 6rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 17rpx;
  border: 1rpx solid rgba(243, 154, 19, .24);
  border-radius: 22rpx;
  background: linear-gradient(110deg, #fff8e1, #ffe0b2);
  box-shadow: 0 8rpx 22rpx rgba(156, 103, 14, .09);
}

.vip-upsell-icon {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, .76);
}

.vip-upsell-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.vip-upsell-title { color: #6d470b; font-size: 23rpx; font-weight: 750; }
.vip-upsell-subtitle { margin-top: 7rpx; overflow: hidden; color: #8a6a36; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.vip-upsell-action { padding: 10rpx 17rpx; flex: none; border-radius: 999rpx; color: #fff; background: #f39a13; font-size: 19rpx; font-weight: 700; }

.tabs-scroll {
  position: sticky;
  top: 0;
  z-index: 4;
  width: 100%;
  border-bottom: 1rpx solid var(--color-border);
  background: rgba(255, 255, 255, .96);
  white-space: nowrap;
}

.tabs { display: inline-flex; padding: 13rpx 30rpx 0; gap: 43rpx; }

.tab {
  position: relative;
  height: 69rpx;
  display: flex;
  align-items: center;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  white-space: nowrap;
}

.tab.active { color: var(--color-text); font-weight: 650; transform: scale(1.04); transform-origin: bottom left; }
.tab-label-row { display:flex; align-items:center; gap:8rpx; }
.tab-notice-dot { width:11rpx; height:11rpx; flex:none; border:2rpx solid #fff; border-radius:50%; background:#e84a3a; box-sizing:border-box; }

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 48rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--color-primary-20);
  transform: translateX(-50%);
}

.panel { padding: 29rpx 24rpx 30rpx; }
.panel.recent-panel { padding-right:32rpx; padding-left:32rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; }
.section-copy { display: flex; flex-direction: column; }
.section-title { color: var(--color-text); font-size: 28rpx; font-weight: 700; }
.section-subtitle { margin-top: 7rpx; color: var(--color-text-secondary); font-size: 20rpx; }

.faces-grid {
  margin-top: 23rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: start;
  gap: 20rpx 16rpx;
}
.recent-faces-grid { gap:22rpx; }

.face-item { position: relative; min-width: 0; transition: transform .15s ease, opacity .15s ease; }

.face-preview {
  width: 100%;
  aspect-ratio: 9/16;
  border: 1rpx solid var(--color-border);
  border-radius: 22rpx;
  box-sizing: border-box;
  background: var(--color-background);
  --qcard-preview-radius: 22rpx;
}
.profile-face-renderer { display: block; overflow: hidden; }
.profile-private-status { display: block; overflow: hidden; }

.face-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #fff;
  background: linear-gradient(145deg, #397054, #6f9b7b);
}

.face-fallback.processing, .face-fallback.pending { background: linear-gradient(145deg, #8a7952, #b39c67); }
.face-fallback.failed { background: linear-gradient(145deg, #9b5551, #c87169); }
.face-state { color: #fff; font-size: 20rpx; }

.face-name {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.face-similar { width:100%; height:56rpx; margin:9rpx 0 0; padding:0; display:flex; align-items:center; justify-content:center; gap:7rpx; border:0; border-radius:13rpx; color:#3e2a05; background:#f8b82d; font-size:19rpx; font-weight:700; line-height:56rpx; }

.face-hover { transform: scale(.975); opacity: .76; }
.feedback-heading { margin-top: 23rpx; }

.feedback-badge {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #8a6b22;
  background: #fff5cf;
  font-size: 18rpx;
}

.feedback-badge.resolved { color: #397054; background: #e5f2e7; }
.feedback-badge.rejected { color: #a74943; background: #fbe6e2; }

.filter-scroll { width: 100%; white-space: nowrap; }
.filters { display: inline-flex; gap: 14rpx; }

.filter {
  height: 58rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  color: var(--color-text-secondary);
  background: var(--color-backdrop);
  font-size: 20rpx;
}

.filter.active { color: #fff; background: var(--color-primary-20); }
.favorites-panel { padding-top: 12rpx; }
.subtabs { display: flex; gap: 34rpx; padding: 0 8rpx 19rpx; }
.subtab { padding: 16rpx 0; color: var(--color-text-secondary); font-size: 21rpx; }
.subtab.active { color: var(--color-text); font-weight: 650; }

.favorite-pack-list { display: flex; flex-direction: column; gap: 18rpx; }

.favorite-pack {
  min-height: 200rpx;
  padding: 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
  gap: 25rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(26, 46, 32, .055);
  transition: transform .15s ease, opacity .15s ease, box-shadow .15s ease;
}

.favorite-pack-cover-wrap { position:relative; width:128rpx; min-height:156rpx; flex:none; overflow:visible; }
.favorite-pack-cover { width:128rpx; height:100%; min-height:156rpx; border-radius:13rpx; background:#e8efe8; box-shadow:0 5rpx 13rpx rgba(27,46,32,.14); }
.goods-pack .favorite-pack-cover-wrap { min-height:168rpx; }
.goods-pack .favorite-pack-cover { min-height:168rpx; }
.favorite-marketing-tag { position:absolute; z-index:2; top:-8rpx; left:-8rpx; padding:5rpx 11rpx; border-radius:999rpx; color:#fff; background:#d85f54; box-shadow:0 3rpx 9rpx rgba(45,34,28,.18); font-size:16rpx; font-weight:750; white-space:nowrap; }
.favorite-marketing-tag.new { background:#52a83c; }
.favorite-marketing-tag.best { background:#e4a424; }
.favorite-card-count { position:absolute; right:0; bottom:0; left:0; height:34rpx; border-radius:0 0 13rpx 13rpx; color:#fff; background:rgba(15,15,15,.55); font-size:17rpx; font-weight:650; line-height:34rpx; text-align:center; backdrop-filter:blur(5rpx); }
.favorite-pack-copy { position:relative; min-width:0; flex:1; padding:7rpx 76rpx 5rpx 0; display:flex; flex-direction:column; }
.favorite-pack-head { display:flex; align-items:center; gap:10rpx; }
.favorite-pack-title { min-width:0; flex:1; overflow:hidden; color:var(--color-text); font-size:27rpx; font-weight:700; line-height:1.25; text-overflow:ellipsis; white-space:nowrap; }
.favorite-difficulty { flex:none; padding:5rpx 12rpx; border-radius:999rpx; color:#7a601f; background:#fff3c9; font-size:17rpx; }
.favorite-taxonomy { margin-top:17rpx; display:flex; align-items:center; gap:7rpx; overflow:hidden; font-size:20rpx; white-space:nowrap; }
.favorite-taxonomy text:first-child { color:#529917; }
.favorite-taxonomy text:nth-child(2) { color:#858b87; font-weight:750; }
.favorite-taxonomy text:last-child { overflow:hidden; color:#b28020; text-overflow:ellipsis; }
.favorite-author { margin-top:13rpx; display:flex; align-items:center; gap:7rpx; color:var(--color-text-secondary); font-size:19rpx; }
.favorite-author image { width:31rpx; height:31rpx; border:1rpx solid var(--color-border); border-radius:50%; background:#fff; }
.favorite-author text { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.favorite-pack-foot { min-height:38rpx; margin-top:auto; display:flex; align-items:flex-end; gap:22rpx; }
.favorite-study-meta { display:flex; align-items:center; gap:6rpx; color:#737c75; font-size:19rpx; white-space:nowrap; }
.favorite-free { color:var(--color-primary); font-size:25rpx; font-weight:800; }
.favorite-price { display:flex; align-items:baseline; gap:11rpx; }
.favorite-price text:first-child { color:var(--color-primary); font-size:25rpx; font-weight:800; }
.favorite-price text:last-child { color:var(--color-disabled); font-size:18rpx; text-decoration:line-through; }
.favorite-pack-action { position:absolute; right:0; bottom:0; width:66rpx; height:66rpx; padding:6rpx; box-sizing:border-box; border-radius:50%; transition:opacity .15s ease,transform .15s ease; }
.favorite-pack-action > view { width:100%; height:100%; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#fff; box-shadow:0 3rpx 10rpx rgba(25,47,31,.11); }
.favorite-pack-action.unlock-action { padding:0; background:linear-gradient(145deg,#ffd46d,#f6b831); box-shadow:0 5rpx 14rpx rgba(153,105,10,.2); }
.favorite-pack-action.unlock-action > view { background:transparent; box-shadow:none; }
.favorite-action-hover { opacity:.76; transform:scale(.94); }
.pack-hover { opacity:.8; transform:scale(.985); box-shadow:0 3rpx 12rpx rgba(26,46,32,.04); }

.favorite-card-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }

.favorite-card {
  position: relative;
  aspect-ratio: 9/16;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(26, 46, 32, .05);
  --qcard-preview-radius: 22rpx;
}

.favorite-card-renderer { display: block; width: 100%; height: 100%; }

.benefits-panel { padding-top: 36rpx; }
.reward-card, .subscribe-card {
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 18rpx;
  background: var(--color-backdrop);
}

.subscribe-card { border-color: rgba(243, 154, 19, .28); background: rgba(243, 154, 19, .08); }
.reward-icon { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: rgba(243, 154, 19, .13); }
.reward-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.reward-title { color: var(--color-text); font-size: 23rpx; font-weight: 700; }
.reward-subtitle { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 19rpx; }

.reward-button {
  width: auto;
  height: 66rpx;
  margin: 0;
  padding: 0 25rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #f39a13;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 66rpx;
}

.reward-button[disabled] { color: var(--color-text-secondary); background: var(--color-tertiary-10); }
.subscribe-link { flex: 0 0 auto; color: var(--color-primary-20); font-size: 20rpx; font-weight: 650; }
.benefit-grid { margin-top:20rpx; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:12rpx; }
.benefit-item { min-width:0; min-height:64rpx; padding:13rpx 16rpx; box-sizing:border-box; display:flex; flex-direction:row; align-items:center; gap:10rpx; border-radius:999rpx; background:rgba(0,0,0,.045); color:var(--color-text-secondary); font-size:19rpx; font-weight:500; }


.panel-loading, .empty-state {
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.loading-dot { width: 32rpx; height: 32rpx; border: 4rpx solid var(--color-border); border-top-color: var(--color-primary); border-radius: 50%; animation: spin .75s linear infinite; }
.empty-title { color: var(--color-text-secondary); }
.empty-button, .view-all {
  width: 100%;
  height: 72rpx;
  margin: 24rpx 0 0;
  border: 1rpx solid var(--color-primary-10);
  border-radius: 14rpx;
  color: var(--color-primary-20);
  background: var(--color-backdrop);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 70rpx;
}

.empty-button { width: auto; margin-top: 2rpx; padding: 0 28rpx; }

.state {
  min-height: 70vh;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.state-title { color: var(--color-text); font-size: 28rpx; font-weight: 700; }
.state-description { color: var(--color-text-secondary); text-align: center; }
.state-button { height: 60rpx; margin-top: 8rpx; padding: 0 28rpx; border: 1rpx solid var(--color-primary); border-radius: 999rpx; color: var(--color-primary); background: #fff; font-size: 22rpx; line-height: 58rpx; }

.profile-skeleton, .content-skeleton {
  width: 100%;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #ecefeb, #f7f8f6, #ecefeb);
  animation: pulse 1.25s ease-in-out infinite alternate;
}

.profile-skeleton { height: 420rpx; }
.content-skeleton { height: 240rpx; }
.content-skeleton.short { height: 130rpx; }

@keyframes spin { to { transform: rotate(360deg); } }
@keyframes pulse { from { opacity: .58; } to { opacity: 1; } }
