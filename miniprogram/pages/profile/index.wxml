<view class="profile-page safe-bottom tab-page">
  <immersive-nav overlay="{{true}}" scroll-top="{{navScrollTop}}">
    <side-drawer-menu wx:if="{{profile}}" slot="leading" profile="{{profile}}" bind:wallet="openCoinHistory" />
    <view slot="action"><button wx:if="{{profile}}" class="settings-button" bindtap="openSettings" aria-label="打开设置" hover-class="soft-hover">
      <ui-icon name="cog" size="{{35}}" color="#3f3f3f" />
    </button></view>
  </immersive-nav>

  <view wx:if="{{loading && !profile}}" class="state">
    <view class="profile-skeleton"></view>
    <view class="content-skeleton"></view>
    <view class="content-skeleton short"></view>
  </view>

  <view wx:elif="{{error && !profile}}" class="state error-state">
    <ui-icon name="alert-circle-outline" size="{{88}}" color="#eb711b" />
    <text class="state-title">个人信息加载失败</text>
    <text class="state-description">{{error}}</text>
    <button class="state-button" bindtap="load">重试</button>
  </view>

  <block wx:elif="{{profile}}">
    <view
      class="profile-header"
      style="{{profileBackground ? 'background-image:url(' + profileBackground + ')' : ''}}"
    >
      <view class="profile-shade"></view>
      <view class="profile-main">
        <view class="avatar-wrap" bindtap="openLevel" hover-class="soft-hover">
          <image class="avatar" src="{{profile.avatar || assets.appIcon}}" mode="aspectFill" />
          <text class="level-badge">Lv.{{profile.experience.level || 1}}</text>
        </view>
        <view class="profile-copy">
          <view class="name-row">
            <text class="name">{{profile.nickname || '叩咔用户'}}</text>
            <text wx:if="{{isVip}}" class="vip-badge">VIP</text>
          </view>
          <view class="id-row" bindtap="copyId" hover-class="soft-hover">
            <text class="id-text"><text class="id-label">ID</text>: {{profile.shortId || '--'}}</text>
            <ui-icon name="content-copy" size="{{25}}" color="#6d776f" />
          </view>
        </view>
      </view>

      <view class="stats-row">
        <view class="stats">
          <view class="stat"><text class="stat-value">{{profile.unlockedCardPackCount || 0}}</text><text class="stat-label">卡包</text></view>
          <view class="stat"><text class="stat-value">{{profile.balance || 0}}</text><text class="stat-label">咔豆</text></view>
          <view class="stat"><text class="stat-value">{{studyTimeText}}</text><text class="stat-label">学习时长</text></view>
        </view>
        <button class="edit-button" bindtap="openProfileEdit" hover-class="soft-hover">编辑资料</button>
      </view>

      <scroll-view scroll-x enhanced class="quick-scroll" show-scrollbar="{{false}}">
        <view class="quick-row">
          <view class="quick-card" bindtap="openCoinHistory" hover-class="quick-hover">
            <text class="quick-title">账户充值</text>
            <text class="quick-subtitle">充值与消费历史</text>
          </view>
          <view class="quick-card" bindtap="openFeedback" hover-class="quick-hover">
            <text class="quick-title">反馈中心</text>
            <text class="quick-subtitle">查看意见处理进度</text>
          </view>
          <view class="quick-card" bindtap="openMyLearning" hover-class="quick-hover">
            <text class="quick-title">我的卡包</text>
            <text class="quick-subtitle">解锁和专属卡包</text>
          </view>
          <view class="quick-card" bindtap="openMyCards" hover-class="quick-hover">
            <text class="quick-title">我的卡面</text>
            <text class="quick-subtitle">AI 私有卡面</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="profile-content">
      <scroll-view scroll-x enhanced class="tabs-scroll" show-scrollbar="{{false}}">
        <view class="tabs">
          <view class="tab {{activeTab === 'recent' ? 'active' : ''}}" data-tab="recent" bindtap="switchTab">
            <text>最近生成</text><view wx:if="{{activeTab === 'recent'}}" class="tab-line"></view>
          </view>
          <view class="tab {{activeTab === 'feedback' ? 'active' : ''}}" data-tab="feedback" bindtap="switchTab">
            <text>卡面反馈</text><view wx:if="{{activeTab === 'feedback'}}" class="tab-line"></view>
          </view>
          <view class="tab {{activeTab === 'favorited' ? 'active' : ''}}" data-tab="favorited" bindtap="switchTab">
            <text>收藏</text><view wx:if="{{activeTab === 'favorited'}}" class="tab-line"></view>
          </view>
          <view class="tab {{activeTab === 'vipBenefits' ? 'active' : ''}}" data-tab="vipBenefits" bindtap="switchTab">
            <text>每日福利</text><view wx:if="{{activeTab === 'vipBenefits'}}" class="tab-line"></view>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{activeTab === 'recent'}}" class="panel recent-panel">
        <view class="section-head">
          <view class="section-copy">
            <text class="section-title">最近生成</text>
            <text class="section-subtitle">点击卡面可预览、反馈或做同款</text>
          </view>
        </view>
        <view wx:if="{{recentCards.length}}" class="faces-grid recent-faces-grid">
          <private-card-face-item
            wx:for="{{recentCards}}"
            wx:key="id"
            item="{{item}}"
            show-make-similar="{{true}}"
            bind:open="openPrivateCard"
            bind:make-similar="makeSimilar"
          />
        </view>
        <view wx:else class="empty-state">
          <ui-icon name="auto-fix" size="{{76}}" color="#3f3f3f" />
          <text class="empty-title">还没有生成过卡面</text>
          <button class="empty-button" bindtap="openAi">立即生成</button>
        </view>
        <button wx:if="{{recentCards.length >= 6}}" class="view-all" bindtap="openMyCards">查看全部卡面</button>
      </view>

      <view wx:elif="{{activeTab === 'feedback'}}" class="panel">
        <scroll-view scroll-x enhanced class="filter-scroll" show-scrollbar="{{false}}">
          <view class="filters">
            <view class="filter {{feedbackStatus === 'all' ? 'active' : ''}}" data-status="all" bindtap="switchFeedbackStatus">全部</view>
            <view class="filter {{feedbackStatus === 'processing' ? 'active' : ''}}" data-status="processing" bindtap="switchFeedbackStatus">处理中</view>
            <view class="filter {{feedbackStatus === 'resolved' ? 'active' : ''}}" data-status="resolved" bindtap="switchFeedbackStatus">已通过</view>
            <view class="filter {{feedbackStatus === 'rejected' ? 'active' : ''}}" data-status="rejected" bindtap="switchFeedbackStatus">已拒绝</view>
          </view>
        </scroll-view>
        <view class="section-copy feedback-heading">
          <text class="section-title">卡面反馈</text>
          <text class="section-subtitle">查看卡面质量问题的处理状态</text>
        </view>
        <view wx:if="{{panelLoading}}" class="panel-loading"><view class="loading-dot"></view><text>加载中...</text></view>
        <view wx:elif="{{feedbackCards.length}}" class="faces-grid">
          <view wx:for="{{feedbackCards}}" wx:key="id" class="face-item" data-id="{{item.id}}" bindtap="openPrivateCard" hover-class="face-hover">
            <private-card-status wx:if="{{item.status !== 'success'}}"
              class="face-preview profile-private-status" status="{{item.status}}" />
            <flip-card wx:elif="{{item.previewCard}}" class="face-preview profile-face-renderer"
              front-card-data="{{item.previewCard}}" aspect-ratio="portrait" preview="{{true}}"
              read-only="{{true}}" hide-flip-button="{{true}}" is-visible="{{true}}" />
            <image wx:elif="{{item.thumbnailUrl}}" class="face-preview" src="{{item.thumbnailUrl}}" mode="aspectFill" />
            <view wx:else class="face-preview face-fallback">
              <ui-icon name="message-text-outline" size="{{54}}" color="#ffffff" />
              <text class="face-state">查看反馈</text>
            </view>
            <block wx:if="{{item.status === 'success'}}">
              <text class="face-name">{{item.name}}</text>
              <text class="feedback-badge {{item.displayFeedbackStatus}}">
                {{item.displayFeedbackStatus === 'resolved' ? '已通过' : item.displayFeedbackStatus === 'rejected' ? '已拒绝' : '处理中'}}
              </text>
            </block>
          </view>
        </view>
        <view wx:else class="empty-state">
          <ui-icon name="message-text-outline" size="{{76}}" color="#6d776f" />
          <text class="empty-title">暂无符合条件的反馈记录</text>
        </view>
      </view>

      <view wx:elif="{{activeTab === 'favorited'}}" class="panel favorites-panel">
        <view class="subtabs">
          <view class="subtab {{favoritesMode === 'packs' ? 'active' : ''}}" data-mode="packs" bindtap="switchFavoritesMode">卡包 {{favoritePacks.length || '-'}}</view>
          <view class="subtab {{favoritesMode === 'cards' ? 'active' : ''}}" data-mode="cards" bindtap="switchFavoritesMode">卡片 {{favoriteCards.length || '-'}}</view>
        </view>
        <view wx:if="{{panelLoading}}" class="panel-loading"><view class="loading-dot"></view><text>加载中...</text></view>
        <view wx:elif="{{favoritesMode === 'packs' && favoritePacks.length}}" class="favorite-pack-list">
          <view wx:for="{{favoritePacks}}" wx:key="id" class="favorite-pack {{item.canStudy ? 'study-pack' : 'goods-pack'}}" data-id="{{item.id}}" bindtap="openFavoritePack" hover-class="pack-hover">
            <view class="favorite-pack-cover-wrap">
              <image class="favorite-pack-cover" src="{{item.cover || assets.appIcon}}" mode="aspectFill" />
              <view wx:if="{{!item.canStudy && (item.isHot || item.isNew || item.isBestSeller)}}" class="favorite-marketing-tag {{item.isNew ? 'new' : item.isBestSeller ? 'best' : 'hot'}}">
                {{item.isNew ? '✨ 新品' : item.isBestSeller ? '👑 畅销' : '🔥 热门'}}
              </view>
              <view wx:if="{{!item.canStudy && item.cardCount}}" class="favorite-card-count">{{item.cardCount}}张</view>
            </view>
            <view class="favorite-pack-copy">
              <view class="favorite-pack-head">
                <text class="favorite-pack-title">{{item.title}}</text>
                <text wx:if="{{!item.canStudy && item.difficulty}}" class="favorite-difficulty">{{item.difficulty}}</text>
              </view>
              <view wx:if="{{item.canStudy}}" class="favorite-taxonomy">
                <text>{{item.subject.name || '综合'}}</text>
                <text>·</text>
                <text>{{item.knowledgePoint.name || '精选内容'}}</text>
              </view>
              <view wx:else class="favorite-author">
                <image src="{{item.author.avatar || assets.appIcon}}" mode="aspectFill" />
                <text>{{item.author.name || '叩咔官方'}}</text>
              </view>
              <view class="favorite-pack-foot">
                <block wx:if="{{item.canStudy}}">
                  <view class="favorite-study-meta"><ui-icon name="cards-outline" size="{{24}}" color="#737c75" /><text>{{item.cardCount || 0}}张</text></view>
                  <view class="favorite-study-meta"><ui-icon name="clock-outline" size="{{24}}" color="#737c75" /><text>{{item.unlockType === 'vip_free' ? 'VIP 免费' : item.timeAgo}}</text></view>
                </block>
                <block wx:else>
                  <text wx:if="{{item.displayPrice === 0}}" class="favorite-free">免费领取</text>
                  <view wx:else class="favorite-price">
                    <text>{{item.displayPrice}}咔豆</text>
                    <text wx:if="{{item.basePrice && item.basePrice !== item.displayPrice}}">{{item.basePrice}}咔豆</text>
                  </view>
                </block>
              </view>
              <view
                class="favorite-pack-action {{item.canStudy ? 'study-action' : 'unlock-action'}}"
                style="{{item.canStudy ? 'background:conic-gradient(#529917 ' + item.progressPercent + '%,#e4e9e4 0)' : ''}}"
                data-id="{{item.id}}"
                catchtap="useFavoritePack"
                hover-class="favorite-action-hover"
                aria-label="{{item.canStudy ? (item.progressPercent > 0 ? '继续学习' : '开始学习') : '解锁卡包'}}"
              >
                <view>
                  <ui-icon name="{{item.canStudy ? 'arrow-right' : 'lock-open-outline'}}" size="{{29}}" color="{{item.canStudy ? '#529917' : '#7b5305'}}" />
                </view>
              </view>
            </view>
          </view>
        </view>
        <view wx:elif="{{favoritesMode === 'cards' && favoriteCards.length}}" class="favorite-card-grid">
          <view wx:for="{{favoriteCards}}" wx:key="id" class="favorite-card" data-id="{{item.id}}" bindtap="openFavoriteCard" hover-class="face-hover">
            <flip-card class="favorite-card-renderer" front-card-data="{{item.previewCard}}"
              aspect-ratio="portrait" preview="{{true}}" read-only="{{true}}"
              hide-flip-button="{{true}}" is-visible="{{true}}" />
          </view>
        </view>
        <view wx:else class="empty-state">
          <ui-icon name="star" size="{{76}}" color="#6d776f" />
          <text class="empty-title">{{favoritesMode === 'packs' ? '还没有收藏的卡包' : '还没有收藏的卡片'}}</text>
        </view>
      </view>

      <view wx:else class="panel benefits-panel">
        <view wx:if="{{isVip}}" class="reward-card">
          <view class="reward-icon"><ui-icon name="star-four-points" size="{{42}}" color="#f39a13" /></view>
          <view class="reward-copy">
            <text class="reward-title">VIP 每日咔豆</text>
            <text class="reward-subtitle">今日可领取 {{profile.vip.dailyRewardAmount || 0}} 咔豆</text>
          </view>
          <button class="reward-button" disabled="{{claimingDailyReward || profile.vip.dailyRewardClaimed}}" bindtap="claimReward">
            {{claimingDailyReward ? '领取中...' : profile.vip.dailyRewardClaimed ? '已领取' : '待领取'}}
          </button>
        </view>
        <view wx:else class="subscribe-card" bindtap="openVipGuide" hover-class="quick-hover">
          <ui-icon name="star-four-points" size="{{44}}" color="#f39a13" />
          <view class="reward-copy">
            <text class="reward-title">订阅后可每日领取咔豆</text>
            <text class="reward-subtitle">请前往叩咔 App 开通 VIP</text>
          </view>
          <text class="subscribe-link">去订阅</text>
        </view>
        <view class="benefit-grid">
          <view class="benefit-item"><ui-icon name="auto-fix" size="{{38}}" color="#529917" /><text>VIP 专属模板</text></view>
          <view class="benefit-item"><ui-icon name="star-four-points" size="{{38}}" color="#f39a13" /><text>VIP 免费卡包</text></view>
        </view>
      </view>
    </view>
  </block>

  <coin-history-drawer
    open="{{coinHistoryOpen}}"
    profile="{{profile}}"
    bind:close="closeCoinHistory"
    bind:recharge="openRechargeGuide"
  />
  <unlock-confirm-drawer
    open="{{unlockPanelOpen}}"
    card-pack-info="{{selectedUnlockPack}}"
    user-balance="{{profile.balance || 0}}"
    is-loading="{{unlocking}}"
    bind:close="closeUnlockPanel"
    bind:confirm="confirmFavoritePackUnlock"
    bind:recharge="openUnlockRecharge"
  />
  <app-purchase-guide
    open="{{purchaseGuideOpen}}"
    mode="{{purchaseGuideMode}}"
    reason="{{purchaseGuideReason}}"
    bind:close="closePurchaseGuide"
  />
</view>
