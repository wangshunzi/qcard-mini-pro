.explore-page { min-height:100vh; background:var(--color-background); }
.explore-header { position:relative; height:468rpx; overflow:visible; background:linear-gradient(145deg,var(--color-primary-10),var(--color-warning-soft)); background-size:cover; background-position:bottom center; }
.header-shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(255,255,255,.1),rgba(255,255,255,.02)); }
.header-pill { min-width:142rpx; height:var(--immersive-control-height); margin:0; padding:0 23rpx; display:flex; align-items:center; justify-content:center; gap:7rpx; box-sizing:border-box; border:var(--immersive-control-border); border-radius:999rpx; background:var(--immersive-control-background); box-shadow:var(--immersive-control-shadow); color:var(--color-text); font-size:23rpx; font-weight:700; line-height:var(--immersive-control-height); backdrop-filter:blur(18rpx); transition:opacity .15s ease,transform .15s ease,box-shadow .15s ease; }
.my-card-button { color:var(--color-primary); }
.header-pill-hover { opacity:.8; transform:scale(.96); box-shadow:0 3rpx 10rpx rgba(24,45,30,.11); }
.header-title { position:relative; z-index:1; padding:var(--immersive-content-safe-top) 48rpx 18rpx; display:flex; flex-direction:column; align-items:flex-start; color:var(--color-text); }
.header-heading { font-size:48rpx; font-weight:900; }
.header-subheading { margin-top:4rpx; color:var(--color-text-secondary); font-size:30rpx; font-weight:550; }
.search { position:absolute; z-index:2; right:32rpx; bottom:-48rpx; left:32rpx; height:96rpx; padding:0 28rpx; display:flex; align-items:center; gap:15rpx; border:1rpx solid var(--color-border); border-radius:28rpx; background:var(--color-card); box-shadow:0 8rpx 24rpx rgba(0,0,0,.11); }
.search input { min-width:0; height:100%; flex:1; font-size:26rpx; }
.clear { padding:12rpx; margin-right:-12rpx; }
.content { padding:64rpx 32rpx 0; }
.face-grid { display:grid; grid-template-columns:1fr 1fr; gap:22rpx; }
.face-card { position:relative; min-width:0; aspect-ratio:9/16; overflow:hidden; border:1rpx solid var(--color-border); border-radius:18rpx; box-sizing:border-box; background:var(--color-card); box-shadow:0 8rpx 24rpx rgba(0,0,0,.07); transition:transform .16s ease,opacity .16s ease; }
.face-card-hover,.face-card.opening { transform:scale(.97); opacity:.72; }
.face-renderer { display:block; width:100%; height:100%; overflow:hidden; border-radius:18rpx; --qcard-preview-radius:18rpx; }
.thumbnail { width:100%; height:100%; border-radius:18rpx; }
.thumbnail.fallback { display:flex; align-items:center; justify-content:center; background:var(--color-primary-10); }
.thumbnail.fallback image { width:90rpx; height:90rpx; border-radius:24rpx; }
.listening-thumbnail { position:relative; overflow:hidden; background:var(--color-info-soft); }
.listening-thumbnail-bg,.listening-thumbnail-shade { position:absolute; inset:0; width:100%; height:100%; }
.listening-thumbnail-shade { background:linear-gradient(180deg,rgba(21,48,38,.44),rgba(21,48,38,.05) 42%,rgba(21,48,38,.48)); }
.listening-thumbnail-content { position:relative; z-index:1; height:100%; padding:16rpx; box-sizing:border-box; display:flex; flex-direction:column; justify-content:space-between; }
.listening-thumbnail-meta { display:flex; align-items:center; justify-content:space-between; gap:8rpx; }
.listening-thumbnail-meta view { height:34rpx; padding:0 12rpx; border:1rpx solid rgba(255,248,233,.62); border-radius:17rpx; display:flex; align-items:center; gap:4rpx; color:var(--color-primary); background:rgba(255,248,233,.64); font-size:15rpx; font-weight:900; }
.listening-thumbnail-title { padding:0 4rpx; overflow:hidden; color:var(--color-text-inverse); font-size:20rpx; line-height:1.3; font-weight:900; text-align:center; text-shadow:0 2rpx 8rpx rgba(0,0,0,.28); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
.listening-thumbnail-play { width:80rpx; height:80rpx; margin:0 auto 58rpx; border:6rpx solid rgba(255,255,255,.34); border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 10rpx 28rpx rgba(44,31,16,.3); }
.make-similar-mask { position:absolute; z-index:4; right:0; bottom:0; left:0; height:86rpx; padding:26rpx 22rpx 10rpx; box-sizing:border-box; border-radius:0 0 18rpx 18rpx; background:linear-gradient(180deg,transparent,rgba(15,15,15,.5)); }
.make-similar-mask button { width:100%; height:50rpx; margin:0; padding:0; border-radius:12rpx; display:flex; align-items:center; justify-content:center; gap:8rpx; color:var(--color-primary); background:var(--color-primary-soft); font-size:22rpx; font-weight:800; line-height:50rpx; box-shadow:0 4rpx 12rpx rgba(0,0,0,.16); }
.state { min-height:500rpx; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:12rpx; color:var(--color-text-secondary); font-size:22rpx; text-align:center; }
.state-title { color:var(--color-text); font-size:28rpx; font-weight:750; }
.state button { height:60rpx; margin-top:8rpx; padding:0 28rpx; border:1rpx solid var(--color-primary); border-radius:999rpx; color:var(--color-primary); background:var(--color-card); font-size:22rpx; line-height:58rpx; }
.skeleton { height:auto; background:linear-gradient(90deg,var(--color-skeleton-base),var(--color-skeleton-highlight),var(--color-skeleton-base)); animation:pulse 1.25s ease-in-out infinite alternate; }
.load-more { padding:30rpx; color:var(--color-text-secondary); font-size:21rpx; text-align:center; }
@keyframes pulse { from { opacity:.58; } to { opacity:1; } }
