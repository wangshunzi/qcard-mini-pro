.login-page {
  position: relative;
  min-height: 100vh;
  padding: 0 0 48rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--color-card);
}

.login-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 520rpx;
}

.login-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 520rpx;
  background: rgba(0, 0, 0, .24);
  animation: login-overlay-in .24s ease-out both;
}

.login-page-back {
  position: fixed;
  z-index: 8;
  left: 32rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, .34);
  border-radius: 999rpx;
  color: #fff;
  background: rgba(10, 18, 17, .38);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .16);
  line-height: 1;
  backdrop-filter: blur(18rpx);
}

.login-page-back::after { border: 0; }
.login-page-back-hover { opacity: .72; transform: scale(.96); }

.brand {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 520rpx;
  padding: calc(72rpx + env(safe-area-inset-top)) 0 32rpx;
  box-sizing: border-box;
}

.brand-mark {
  width: 124rpx;
  height: 124rpx;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 26rpx rgba(0, 0, 0, .12);
}

.login-panel {
  position: relative;
  z-index: 2;
  min-height: calc(100vh - 470rpx);
  margin-top: -28rpx;
  padding: 48rpx 32rpx calc(112rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--color-card);
  animation: login-sheet-up .3s cubic-bezier(.22, 1, .36, 1) both;
  transform-origin: bottom center;
  will-change: transform, opacity;
}

.login-mode { animation:login-mode-in .2s ease-out; }
.choice-mode { padding-top:118rpx; }
.login-intro { width:600rpx; max-width:100%; margin:0 auto 56rpx; text-align:left; }
.login-intro-title { display:block; color:var(--color-text); font-size:32rpx; font-weight:750; line-height:1.35; letter-spacing:.5rpx; }
.login-intro-subtitle { display:block; margin-top:10rpx; color:var(--color-text-muted); font-size:21rpx; line-height:1.5; }
.login-options { width:600rpx; max-width:100%; margin:0 auto; display:flex; flex-direction:column; gap:32rpx; }
.login-method-button { width:100%; height:92rpx; margin:0; padding:0 28rpx; box-sizing:border-box; border-radius:24rpx; font-size:28rpx; font-weight:700; line-height:92rpx; transition:opacity .15s ease,transform .15s ease,background .15s ease; }
.login-method-button::after,.mode-back-button::after { border:0; }
.wechat-login-button { border:0; color:#fff; background:#07c160; box-shadow:0 14rpx 30rpx rgba(7,193,96,.18); }
.wechat-login-hover { background:#06ad56; transform:scale(.99); }
.phone-login-button { border:1rpx solid var(--color-border); color:var(--color-text); background:var(--color-backdrop); box-shadow:none; }
.phone-login-hover { opacity:.78; transform:scale(.99); }
.choice-error { margin:28rpx auto 0; text-align:center; }

.phone-mode-header { height:64rpx; margin-bottom:30rpx; display:flex; align-items:center; justify-content:space-between; }
.mode-back-button { width:64rpx; height:64rpx; margin:0; padding:0; display:flex; align-items:center; justify-content:center; border:0; border-radius:50%; color:var(--color-primary); background:var(--color-primary-10); line-height:1; }
.mode-back-hover { opacity:.7; }
.phone-mode-title { color:var(--color-text); font-size:28rpx; font-weight:700; }
.phone-mode-header-spacer { width:64rpx; height:64rpx; }

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 650;
}

.field-control {
  height: 92rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 0;
  border-radius: 20rpx;
  background: var(--color-backdrop);
}

.field-input { flex: 1; height: 100%; font-size: 29rpx; }
.code-button { min-width:156rpx; padding: 0 10rpx; border:0; color: var(--color-success); background: transparent; font-size: 23rpx; font-weight:600; line-height: 58rpx; }
.code-button[disabled] { color:var(--color-muted); background:transparent; }
.primary-button {
  height: 92rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
}
.primary-button { margin-top: 12rpx; color: var(--color-text-inverse); background: var(--color-primary); }
.primary-button[disabled] { color:var(--color-text-inverse); background:var(--color-disabled); opacity:.58; }
.primary-button-hover { opacity:.88; transform:scale(.99); }
.agreement-row { margin-top:46rpx; display:flex; align-items:center; justify-content:center; flex-wrap:wrap; color:var(--color-text-muted); font-size:21rpx; line-height:38rpx; }
.agreement-checkbox { width:28rpx; height:28rpx; margin-right:5rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; border:3rpx solid var(--color-border); border-radius:7rpx; background:var(--color-card); }
.agreement-checkbox.checked { border-color:var(--color-success); background:var(--color-success); }
.agreement-copy,.agreement-link { padding:0 2rpx; }
.agreement-link { color:var(--color-primary); }
.error { display: block; margin: -4rpx 4rpx 8rpx; color: var(--color-error); font-size: 24rpx; }

.icp { position:fixed; right:0; bottom:calc(12rpx + env(safe-area-inset-bottom)); left:0; z-index:4; width:420rpx; max-width:calc(100vw - 48rpx); height:auto; display:block; margin:0 auto; padding:8rpx 12rpx; border:0; color:var(--color-muted); background:transparent; font-size:19rpx; line-height:1.4; text-align:center; }
.icp::after { border:0; }
.icp-hover { opacity:.68; }

.agreement-modal { position:fixed; inset:0; z-index:20; display:flex; align-items:center; justify-content:center; padding:40rpx; box-sizing:border-box; }
.agreement-modal-backdrop { position:absolute; inset:0; background:rgba(0,0,0,.58); animation:agreement-backdrop-in .18s ease-out; }
.agreement-modal-card { position:relative; z-index:1; width:600rpx; max-width:100%; padding:44rpx 36rpx 32rpx; box-sizing:border-box; border:1rpx solid var(--color-border); border-radius:30rpx; background:var(--color-card); box-shadow:0 28rpx 80rpx rgba(0,0,0,.28); animation:agreement-card-in .2s ease-out; }
.agreement-modal-title { display:block; color:var(--color-text); font-size:32rpx; font-weight:750; line-height:1.4; text-align:center; }
.agreement-modal-copy { color:var(--color-text-muted); font-size:23rpx; line-height:1.65; text-align:center; }
.agreement-modal-title + .agreement-modal-copy { display:block; margin-top:16rpx; }
.agreement-modal-links { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; }
.agreement-modal-link { padding:0 3rpx; color:var(--color-primary); font-size:23rpx; line-height:1.65; }
.agreement-modal-actions { margin-top:38rpx; display:flex; gap:20rpx; }
.agreement-modal-button { flex:1; height:84rpx; margin:0; padding:0 12rpx; border-radius:21rpx; font-size:26rpx; font-weight:700; line-height:84rpx; }
.agreement-modal-button::after { border:0; }
.agreement-modal-button.cancel { border:1rpx solid var(--color-border); color:var(--color-text-secondary); background:var(--color-backdrop); }
.agreement-modal-button.confirm { border:0; color:#fff; background:#07c160; }
.agreement-modal-hover { opacity:.82; transform:scale(.99); }

@keyframes login-mode-in { from { opacity:0; transform:translateY(10rpx); } to { opacity:1; transform:translateY(0); } }
@keyframes login-overlay-in { from { opacity:0; } to { opacity:1; } }
@keyframes login-sheet-up { from { opacity:.72; transform:translateY(100%); } to { opacity:1; transform:translateY(0); } }
@keyframes agreement-backdrop-in { from { opacity:0; } to { opacity:1; } }
@keyframes agreement-card-in { from { opacity:0; transform:translateY(18rpx) scale(.98); } to { opacity:1; transform:translateY(0) scale(1); } }

@media (max-height:720px) {
  .choice-mode { padding-top:24rpx; }
  .login-intro { margin-bottom:30rpx; }
  .agreement-row { margin-top:30rpx; }
}
