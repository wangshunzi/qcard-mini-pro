<view class="login-page safe-bottom">
  <image class="login-background" src="{{loginBackground}}" mode="aspectFill" />
  <view class="login-overlay"></view>
  <view class="brand">
    <image class="brand-mark" src="{{assets.appIcon}}" mode="aspectFit" />
  </view>

  <view class="login-panel">
    <view wx:if="{{loginMode === 'choice'}}" class="login-mode choice-mode">
      <view class="login-intro">
        <text class="login-intro-title">继续你的学习旅程</text>
        <text class="login-intro-subtitle">同步卡包、学习进度与记录</text>
      </view>
      <view class="login-options" aria-role="group" aria-label="选择登录方式">
        <button
          class="login-method-button wechat-login-button"
          loading="{{loggingIn}}"
          disabled="{{loggingIn}}"
          bindtap="onWechatLogin"
          aria-label="微信登录"
          hover-class="wechat-login-hover"
        >{{loggingIn ? '登录中' : '微信登录'}}</button>
        <button
          class="login-method-button phone-login-button"
          disabled="{{loggingIn}}"
          bindtap="showPhoneLogin"
          aria-label="手机号登录"
          hover-class="phone-login-hover"
        >手机号登录</button>
      </view>
      <text wx:if="{{error}}" class="error choice-error">{{error}}</text>
    </view>

    <view wx:else class="login-mode phone-mode">
      <view class="phone-mode-header">
        <button class="mode-back-button" bindtap="showLoginChoices" aria-label="返回登录方式" hover-class="mode-back-hover">
          <ui-icon name="chevron-left" size="{{28}}" color="var(--color-primary)" />
        </button>
        <text class="phone-mode-title">手机号登录</text>
        <view class="phone-mode-header-spacer"></view>
      </view>

      <view class="field">
        <text class="field-label">手机号</text>
        <view class="field-control">
          <ui-icon name="cellphone" size="{{42}}" color="var(--color-text-muted)" />
          <input
            class="field-input"
            type="number"
            maxlength="11"
            placeholder="请输入手机号"
            value="{{phoneNumber}}"
            bindinput="onPhoneInput"
          />
        </view>
      </view>
      <view class="field">
        <text class="field-label">验证码</text>
        <view class="field-control code-control">
          <ui-icon name="shield-key-outline" size="{{40}}" color="var(--color-text-muted)" />
          <input
            class="field-input"
            type="number"
            maxlength="6"
            placeholder="请输入验证码"
            value="{{code}}"
            bindinput="onCodeInput"
            confirm-type="done"
            bindconfirm="onPhoneLogin"
          />
          <button
            class="code-button"
            disabled="{{sending || countdown > 0 || !canSendCode}}"
            bindtap="onSendCode"
          >
            {{sending ? '发送中' : (countdown > 0 ? countdown + 's' : '获取验证码')}}
          </button>
        </view>
      </view>
      <text wx:if="{{error}}" class="error">{{error}}</text>
      <button
        class="primary-button"
        loading="{{loggingIn}}"
        disabled="{{loggingIn || !canPhoneLogin}}"
        bindtap="onPhoneLogin"
        hover-class="primary-button-hover"
      >
        {{loggingIn ? '登录中' : '登录'}}
      </button>
    </view>

    <view class="agreement-row">
      <view
        class="agreement-checkbox {{agreed ? 'checked' : ''}}"
        bindtap="toggleAgreement"
        aria-role="checkbox"
        aria-checked="{{agreed}}"
        aria-label="同意用户协议和隐私政策"
      >
        <ui-icon wx:if="{{agreed}}" name="check" size="{{21}}" color="var(--color-text-inverse)" />
      </view>
      <text class="agreement-copy" bindtap="toggleAgreement">我已阅读并同意</text>
      <text class="agreement-link" catchtap="openAgreement">《用户协议》</text>
      <text class="agreement-copy">和</text>
      <text class="agreement-link" catchtap="openPrivacy">《隐私政策》</text>
    </view>
  </view>
  <button
    class="icp"
    bindtap="openFilingQuery"
    aria-label="查询小程序备案信息 {{filingNumber}}"
    hover-class="icp-hover"
  >{{filingNumber}}</button>

  <view wx:if="{{agreementPromptOpen}}" class="agreement-modal" catchtouchmove="noop">
    <view class="agreement-modal-backdrop" bindtap="cancelAgreementPrompt"></view>
    <view class="agreement-modal-card" aria-role="dialog" aria-label="协议确认">
      <text class="agreement-modal-title">请阅读并同意协议</text>
      <text class="agreement-modal-copy">登录即表示你已阅读并同意</text>
      <view class="agreement-modal-links">
        <text class="agreement-modal-link" catchtap="openAgreement">《用户协议》</text>
        <text class="agreement-modal-copy">和</text>
        <text class="agreement-modal-link" catchtap="openPrivacy">《隐私政策》</text>
      </view>
      <view class="agreement-modal-actions">
        <button class="agreement-modal-button cancel" bindtap="cancelAgreementPrompt" hover-class="agreement-modal-hover">暂不登录</button>
        <button class="agreement-modal-button confirm" bindtap="confirmAgreementAndLogin" hover-class="agreement-modal-hover">同意并登录</button>
      </view>
    </view>
  </view>
</view>
