<page-meta page-style="{{purchaseGuideOpen || unlockPanelOpen || gradeDrawerOpen || cardPreviewOpen ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="resource-page safe-bottom tab-page">
  <immersive-nav overlay="{{true}}" light="{{true}}" scroll-top="{{navScrollTop}}">
    <button
      slot="leading"
      class="drawer-selector-trigger {{gradeDrawerOpen ? 'open' : ''}}"
      bindtap="openGradeDrawer"
      hover-class="drawer-selector-trigger-hover"
      aria-label="选择年级"
    >
      <image wx:if="{{grades[gradeIndex].icon}}" class="drawer-selector-trigger-icon" src="{{grades[gradeIndex].icon}}" mode="aspectFit" />
      <ui-icon wx:else name="book-open-outline" size="{{27}}" color="#4f3218" />
      <text class="drawer-selector-trigger-label">{{selectedGradeName}}</text>
      <ui-icon class="drawer-selector-trigger-chevron" name="chevron-down" size="{{26}}" color="#303630" />
    </button>
    <view slot="action" class="app-segmented nav-segmented" aria-role="tablist">
      <button class="app-segmented-option {{mode === 'cardpack' ? 'active' : ''}}" data-mode="cardpack" bindtap="switchMode" hover-class="app-segmented-option-hover" aria-role="tab" aria-checked="{{mode === 'cardpack'}}">卡包</button>
      <button class="app-segmented-option {{mode === 'preview' ? 'active' : ''}}" data-mode="preview" bindtap="switchMode" hover-class="app-segmented-option-hover" aria-role="tab" aria-checked="{{mode === 'preview'}}">预览</button>
    </view>
  </immersive-nav>
  <view
    class="resource-header"
    style="{{resourceBackground ? 'background-image:url(' + resourceBackground + ')' : ''}}"
  >
    <view class="header-shade"></view>
    <view class="header-title">
      <text class="header-heading">卡包</text>
      <text class="header-subheading">{{mode === 'cardpack' ? '按年级和学科查找卡包' : '查看卡片预览，先看效果再选卡包'}}</text>
    </view>
    <view class="search">
      <ui-icon name="magnify" size="{{37}}" color="#5d5d5d" />
      <input class="search-input" value="{{query}}" placeholder="{{mode === 'preview' ? '搜索预览卡片...' : '搜索卡包名称...'}}" bindinput="onInput" confirm-type="search" />
      <view wx:if="{{query}}" class="clear" bindtap="clearSearch">
        <ui-icon name="close-circle" size="{{34}}" color="#a9a9a9" />
      </view>
    </view>
  </view>

  <view class="resource-content">
    <view wx:if="{{error && !loading}}" class="state error-state">
      <ui-icon name="alert-circle-outline" size="{{88}}" color="#eb711b" />
      <text class="state-title">资源加载失败</text>
      <text>{{error}}</text>
      <button class="state-button" bindtap="load">重新加载</button>
    </view>

    <view wx:elif="{{loading}}" class="loading-state">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton"></view>
    </view>

    <block wx:elif="{{mode === 'preview'}}">
      <view wx:if="{{previewItems.length}}" class="preview-grid">
        <view wx:for="{{previewItems}}" wx:key="id" class="preview-card" data-id="{{item.id}}" bindtap="openPreview" hover-class="card-hover">
          <view class="resource-preview-shell">
            <flip-card
              class="resource-preview-renderer"
              front-card-data="{{item.previewCard}}"
              aspect-ratio="portrait"
              preview="{{true}}"
              read-only="{{true}}"
              hide-flip-button="{{true}}"
              is-visible="{{true}}"
            />
          </view>
          <view class="preview-copy">
            <text class="preview-title">{{item.name}}</text>
            <text class="preview-meta">{{item.cardPack.title}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="state">
        <ui-icon name="magnify" size="{{88}}" color="#3f3f3f" />
        <text class="state-title">暂无预览卡片</text>
      </view>
      <view wx:if="{{previewLoadingMore}}" class="load-more">正在加载更多…</view>
    </block>

    <block wx:elif="{{searching}}">
      <view class="result-head"><text class="result-title">“{{query}}”的搜索结果</text><text class="result-count">{{searchItems.length}} 个</text></view>
      <view wx:if="{{searchItems.length}}" class="pack-grid">
        <view wx:for="{{searchItems}}" wx:key="id" data-id="{{item.id}}" bindtap="openPack" hover-class="card-hover" class="pack-card">
          <image class="pack-cover" src="{{item.cover || assets.appIcon}}" mode="aspectFill" />
          <view class="pack-copy">
            <view class="pack-title">{{item.title}}</view>
            <view class="pack-meta">{{item.cardCount || 0}} 张 · {{item.subject.name || '综合'}}</view>
            <view class="pack-footer">
              <text wx:if="{{item.isUnlocked}}" class="unlocked">已解锁</text>
              <text wx:else>{{item.priceInfo.finalPrice || item.basePrice || 0}} 咔豆</text>
              <ui-icon name="chevron-right" size="{{27}}" color="#a9a9a9" />
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="state">
        <ui-icon name="magnify" size="{{88}}" color="#3f3f3f" />
        <text class="state-title">没有找到相关卡包</text>
      </view>
      <view wx:if="{{loadingMore}}" class="load-more">正在加载更多…</view>
    </block>

    <block wx:else>
      <scroll-view class="subjects" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="subject-row">
          <view wx:for="{{subjects}}" wx:key="id" class="subject {{subjectIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectSubject" hover-class="subject-hover">{{item.name}}</view>
        </view>
      </scroll-view>

      <view wx:if="{{knowledgePoints.length}}" class="knowledge-timeline">
        <view class="timeline-line"></view>
        <view wx:for="{{knowledgePoints}}" wx:key="id" class="knowledge-item">
          <view class="knowledge-heading" data-id="{{item.id}}" bindtap="toggleKnowledge">
            <view class="knowledge-heading-left">
              <view class="knowledge-icon"><ui-icon name="book-open-outline" size="{{24}}" color="#529917" /></view>
              <text>{{item.name}}</text>
            </view>
            <view class="knowledge-chevron {{item.collapsed ? '' : 'expanded'}}">
              <ui-icon name="chevron-down" size="{{34}}" color="#777d79" />
            </view>
          </view>
          <view wx:if="{{!item.collapsed}}" class="knowledge-panel">
            <view wx:if="{{item.cardPacks.length}}" class="knowledge-pack-list">
              <view
                wx:for="{{item.cardPacks}}"
                wx:for-item="pack"
                wx:key="id"
                class="knowledge-pack"
                data-id="{{pack.id}}"
                bindtap="openPack"
                hover-class="card-hover"
              >
                <view class="knowledge-cover-wrap">
                  <image class="knowledge-cover" src="{{pack.cover || assets.appIcon}}" mode="aspectFill" />
                  <view wx:if="{{pack.isHot || pack.isNew || pack.isBestSeller}}" class="marketing-tag {{pack.isNew ? 'new' : pack.isBestSeller ? 'best' : 'hot'}}">
                    {{pack.isNew ? '新品' : pack.isBestSeller ? '畅销' : '热门'}}
                  </view>
                  <view wx:if="{{pack.cardCount}}" class="card-count">{{pack.cardCount}}张</view>
                </view>
                <view class="knowledge-pack-copy">
                  <view class="knowledge-pack-head">
                    <text class="knowledge-pack-title">{{pack.title}}</text>
                    <text wx:if="{{pack.difficulty}}" class="difficulty">{{pack.difficulty}}</text>
                  </view>
                  <view class="author-row">
                    <image src="{{pack.author.avatar || assets.appIcon}}" mode="aspectFill" />
                    <text>{{pack.author.name || '叩咔官方'}}</text>
                  </view>
                  <view class="knowledge-pack-foot">
                    <block wx:if="{{!pack.canStudy}}">
                      <text wx:if="{{pack.displayPrice === 0}}" class="free-price">免费领取</text>
                      <view wx:else class="price-row">
                        <text>{{pack.displayPrice}}咔豆</text>
                        <text wx:if="{{pack.basePrice && pack.basePrice !== pack.displayPrice}}">{{pack.basePrice}}咔豆</text>
                      </view>
                    </block>
                    <view wx:else class="last-study">
                      <ui-icon name="clock-outline" size="{{25}}" color="#858b87" />
                      <text>{{pack.unlockType === 'vip_free' ? 'VIP 免费' : pack.timeAgo}}</text>
                    </view>
                  </view>
                  <view
                    class="pack-action {{pack.canStudy ? 'study-action' : 'unlock-action'}}"
                    style="{{pack.canStudy ? 'background:conic-gradient(#529917 ' + pack.progressPercent + '%,#e4e9e4 0)' : ''}}"
                    data-id="{{pack.id}}"
                    catchtap="startPack"
                    hover-class="pack-action-hover"
                  >
                    <view>
                      <ui-icon name="{{pack.canStudy ? 'arrow-right' : 'lock-open-outline'}}" size="{{29}}" color="{{pack.canStudy ? '#529917' : '#7b5305'}}" />
                    </view>
                  </view>
                </view>
              </view>
            </view>
            <view wx:else class="knowledge-empty">暂无卡包</view>
          </view>
        </view>
      </view>
      <view wx:if="{{!knowledgePoints.length}}" class="state">
        <ui-icon name="book-open-outline" size="{{88}}" color="#3f3f3f" />
        <text class="state-title">当前学科暂无资源</text>
      </view>
    </block>
  </view>

  <selection-side-drawer
    open="{{gradeDrawerOpen}}"
    title="选择年级"
    subtitle="切换后同步更新学科与知识点"
    items="{{grades}}"
    selected-id="{{grades[gradeIndex].id || ''}}"
    trigger-icon="book-open-outline"
    bind:close="closeGradeDrawer"
    bind:select="selectGrade"
  />
  <unlock-confirm-drawer
    open="{{unlockPanelOpen}}"
    card-pack-info="{{selectedUnlockPack}}"
    user-balance="{{userBalance}}"
    is-loading="{{unlocking}}"
    bind:close="closeUnlockPanel"
    bind:confirm="confirmPackUnlock"
    bind:recharge="openUnlockRecharge"
  />
  <app-purchase-guide
    open="{{purchaseGuideOpen}}"
    mode="{{purchaseGuideMode}}"
    reason="{{purchaseGuideReason}}"
    balance="{{userBalance}}"
    is-vip="{{isVip}}"
    bind:close="closePurchaseGuide"
    bind:success="onVirtualPaymentFulfilled"
  />
  <card-preview-modal open="{{cardPreviewOpen}}" payload="{{cardPreviewPayload}}" bind:close="closeCardPreview" />
</view>
