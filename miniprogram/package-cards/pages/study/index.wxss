.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-background);
  color: var(--color-text);
}

.study-header {
  flex: none;
  background: var(--color-background);
  border-bottom: 1rpx solid var(--color-border);
}

.header-row {
  position: relative;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.study-nav-controls {
  position: relative;
  z-index: 2;
  min-width: 72rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pack-info {
  position: absolute;
  top: 0;
  left: 50%;
  width: 360rpx;
  height: 100%;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  transform: translateX(-50%);
}

.title-row {
  max-width: 100%;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cover {
  width: 32rpx;
  height: 32rpx;
  flex: none;
  border-radius: 8rpx;
}

.pack-title {
  max-width: 360rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-badge {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #ff9800;
  font-size: 19rpx;
  font-weight: 700;
}

.progress-text {
  display: block;
  margin: 12rpx 0 10rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.35;
  text-align: center;
}

.progress-track {
  width: 100%;
  height: 4rpx;
  background: var(--color-tertiary-10);
}

.progress-fill {
  height: 100%;
  border-radius: 2rpx;
  background: var(--color-success);
  transition: width 300ms ease;
}

.icon-button {
  width: var(--immersive-control-height);
  min-width: var(--immersive-control-height);
  height: var(--immersive-control-height);
  margin: 0;
  padding: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 400;
  border: var(--immersive-control-border);
  line-height: 1;
  box-shadow: var(--immersive-control-shadow);
  backdrop-filter: blur(18rpx);
}

.icon-button[disabled] {
  opacity: .42;
}

.icon-button.light {
  color: var(--color-text);
  background: var(--immersive-control-background);
}

.icon-button.unlock {
  color: #27533b;
  background: #d9efdf;
  font-size: 30rpx;
}

.icon-placeholder {
  width: 72rpx;
  height: 72rpx;
}

.cards-container {
  flex: 1;
  min-height: 0;
  margin: 16rpx;
  overflow: hidden;
}

.swiper {
  width: 100%;
  height: 100%;
}

.slide {
  padding: 32rpx;
  box-sizing: border-box;
}

.study-card {
  display: block;
  width: 100%;
  height: 100%;
  margin: auto;
}

.deferred-card {
  width: 100%;
  height: 100%;
}

.locked-card,
.placeholder-card {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
  border-radius: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: var(--color-text-secondary);
  background: var(--color-card);
  box-shadow: 0 18rpx 48rpx rgba(33, 68, 49, .1);
}

.lock-circle,
.complete-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--color-primary-20);
  font-size: 44rpx;
}

.locked-title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
}

.locked-copy {
  font-size: 25rpx;
}

.unlock-card-button {
  margin: 16rpx 0 0;
  padding: 0 40rpx;
  border-radius: 999rpx;
  color: #fff;
  background: var(--color-primary-20);
  font-size: 26rpx;
  line-height: 72rpx;
}

.placeholder-shimmer {
  width: 120rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #edf1ed, #dbe5dd, #edf1ed);
  animation: shimmer 1.2s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% { opacity: .45; transform: scaleX(.75); }
  50% { opacity: 1; transform: scaleX(1); }
}

.state-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 48rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  text-align: center;
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #ce665f;
  font-size: 56rpx;
  font-weight: 700;
}

.state-icon.small {
  width: 72rpx;
  height: 72rpx;
  font-size: 40rpx;
}

.state-title {
  color: var(--color-text);
  font-size: 30rpx;
}

.state-actions {
  display: flex;
  gap: 24rpx;
}

.text-button {
  min-width: 140rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: var(--color-text-secondary);
  background: transparent;
  font-size: 26rpx;
  line-height: 64rpx;
}

.text-button.primary {
  color: var(--color-primary-20);
  border: 1rpx solid var(--color-primary-20);
}

.study-controls {
  flex: none;
  min-height: 104rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--color-border);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  background: var(--color-background);
  box-sizing: content-box;
}

.controls-spacer {
  width: 72rpx;
}

.control-group {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.icon-button.control {
  color: #fff;
  background: var(--color-primary-20);
  box-shadow: none;
}

.icon-button.control.finish {
  color: var(--color-primary-20);
  background: var(--color-primary-10);
}

.icon-button.control.disabled {
  color: var(--color-disabled);
  background: var(--color-tertiary-10);
}

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(19, 29, 24, .58);
}

.completion-modal {
  width: 100%;
  max-width: 640rpx;
  padding: 48rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--color-card);
}

.complete-title {
  margin-top: 28rpx;
  color: var(--color-primary-20);
  font-size: 40rpx;
  font-weight: 600;
}

.complete-subtitle {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
}

.stats {
  width: 100%;
  margin-top: 40rpx;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  color: var(--color-text-secondary);
  background: var(--color-background);
  font-size: 27rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
}

.stat-value {
  color: var(--color-primary-20);
  font-weight: 600;
}

.modal-actions {
  width: 100%;
  margin-top: 40rpx;
  display: flex;
  gap: 24rpx;
}

.modal-button {
  flex: 1;
  margin: 0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  line-height: 80rpx;
}

.modal-button.secondary {
  color: var(--color-text-secondary);
  background: var(--color-tertiary-10);
}

.modal-button.primary-outline {
  color: var(--color-primary-20);
  border: 1rpx solid var(--color-border);
  background: var(--color-background);
}

.spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid var(--color-tertiary-10);
  border-top-color: var(--color-primary-20);
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
