<page-meta page-style="{{purchaseGuideOpen || unlockPanelOpen ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="page safe-bottom">
  <immersive-nav title="{{teacher.name || '老师主页'}}" back="{{true}}" border="{{true}}" />
  <view wx:if="{{loading}}" class="state">
    <view class="loading-orbit"></view><text>正在加载老师主页…</text>
  </view>
  <view wx:elif="{{error}}" class="state">
    <ui-icon name="alert-circle-outline" size="{{74}}" color="var(--color-error)" />
    <text>{{error}}</text><button bindtap="load">重试</button>
  </view>
  <block wx:elif="{{teacher}}">
    <view class="hero">
      <image class="avatar" src="{{teacher.avatar || assets.appIcon}}" mode="aspectFill" />
      <view class="teacher-copy">
        <view class="name-line">
          <text class="name">{{teacher.name}}</text>
          <text wx:if="{{teacher.title}}" class="teacher-title">{{teacher.title}}</text>
        </view>
        <view class="rating">
          <text class="rating-label">评分：</text>
          <ui-icon wx:for="{{ratingStars}}" wx:key="index" name="star" size="{{23}}" color="{{item.active ? 'var(--color-warning)' : 'var(--color-border)'}}" />
          <text class="rating-number">{{teacher.rating || 0}}</text>
        </view>
        <text class="bio">{{teacher.bio || teacher.detail || '专注于优质学习卡片内容'}}</text>
      </view>
    </view>
    <view class="content">
      <view class="heading"><text>卡包列表 ({{cardPacks.length}})</text></view>
      <view wx:if="{{cardPacks.length}}" class="list">
        <view wx:for="{{cardPacks}}" wx:key="id" class="pack-card" data-id="{{item.id}}" bindtap="openPack" hover-class="pack-card-hover">
          <view class="pack-cover-wrap">
            <image class="pack-cover" src="{{item.cover || assets.appIcon}}" mode="aspectFill" />
            <text wx:if="{{item.isBestSeller || item.isHot || item.isNew}}" class="pack-mark {{item.isNew ? 'new' : item.isBestSeller ? 'best' : 'hot'}}">{{item.isNew ? '新品' : item.isBestSeller ? '畅销' : '热门'}}</text>
          </view>
          <view class="pack-copy">
            <view class="pack-title-row">
              <text class="pack-title">{{item.title}}</text>
              <text class="subject-badge">{{item.subject.name || '综合'}}</text>
            </view>
            <view class="pack-meta">
              <view><ui-icon name="cards-outline" size="{{24}}" color="var(--color-text-secondary)" /><text>{{item.cardCount || 0}} 张</text></view>
              <view wx:if="{{item.knowledgePoint.name}}"><ui-icon name="target" size="{{23}}" color="var(--color-text-secondary)" /><text>{{item.knowledgePoint.name}}</text></view>
            </view>
            <text class="pack-description">{{item.description || '精选学习卡包，循序渐进掌握知识'}}</text>
            <view class="card-footer">
              <view class="access-copy {{item.canStudy ? 'available' : ''}}">
                <ui-icon name="{{item.canStudy ? 'check-circle' : item.unlockType === 'vip_free' ? 'crown' : 'wallet'}}" size="{{26}}" color="{{item.canStudy ? 'var(--color-primary)' : item.unlockType === 'vip_free' ? 'var(--color-warning)' : 'var(--color-warning)'}}" />
                <text wx:if="{{item.canStudy}}">{{item.isUnlocked ? '已解锁' : 'VIP 免费'}}</text>
                <text wx:elif="{{item.unlockType === 'vip_free'}}">VIP 免费</text>
                <text wx:else>{{item.priceInfo.finalPrice || item.basePrice || 0}} 咔豆</text>
              </view>
              <button wx:if="{{item.canStudy}}" class="card-action study" data-id="{{item.id}}" catchtap="startStudy"><text>开始学习</text><ui-icon name="arrow-right" size="{{25}}" color="var(--color-text-inverse)" /></button>
              <button wx:else class="card-action unlock" loading="{{unlockingId === item.id}}" data-id="{{item.id}}" catchtap="unlock"><text>解锁</text><ui-icon wx:if="{{unlockingId !== item.id}}" name="lock-open-outline" size="{{24}}" color="var(--color-text-inverse)" /></button>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="empty">该教师暂无卡包</view>
    </view>
  </block>
  <unlock-confirm-drawer
    open="{{unlockPanelOpen}}"
    card-pack-info="{{selectedUnlockPack}}"
    user-balance="{{userBalance}}"
    is-loading="{{unlockingId}}"
    bind:close="closeUnlockPanel"
    bind:confirm="confirmUnlock"
    bind:recharge="openUnlockRecharge"
  />
  <app-purchase-guide
    open="{{purchaseGuideOpen}}"
    mode="{{purchaseGuideMode}}"
    reason="{{purchaseGuideReason}}"
    balance="{{userBalance}}"
    is-vip="{{isVip}}"
    bind:close="closePurchaseGuide"
    bind:success="onVirtualPaymentFulfilled"
  />
</view>
