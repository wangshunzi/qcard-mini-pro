<page-meta page-style="{{themePageStyle}}{{purchaseGuideOpen ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="page safe-bottom theme-{{themeMode}}">
  <immersive-nav back="{{true}}" overlay="{{true}}" light="{{true}}" scroll-top="{{navScrollTop}}">
    <view slot="action" class="app-segmented nav-segmented" aria-role="tablist">
      <button class="app-segmented-option {{mode === 'unlocked' ? 'active' : ''}}" data-mode="unlocked" bindtap="switchMode" hover-class="app-segmented-option-hover" aria-role="tab" aria-checked="{{mode === 'unlocked'}}">已解锁</button>
      <button class="app-segmented-option {{mode === 'private' ? 'active' : ''}}" data-mode="private" bindtap="switchMode" hover-class="app-segmented-option-hover" aria-role="tab" aria-checked="{{mode === 'private'}}">专属</button>
    </view>
  </immersive-nav>
  <view class="hero" style="{{heroBackground ? 'background-image:url(' + heroBackground + ')' : ''}}">
    <view class="hero-title">我的卡包</view>
    <view class="hero-subtitle">管理你的所有卡包</view>
    <view class="search">
      <ui-icon name="magnify" size="{{36}}" color="var(--color-text-secondary)" />
      <input class="search-input" value="{{query}}" bindinput="onInput" placeholder="搜索卡包名称..." />
      <button wx:if="{{mode === 'unlocked'}}" class="filter-trigger {{filterCount ? 'has-filter' : ''}}" bindtap="toggleFilter" aria-label="筛选卡包">
        <ui-icon name="filter-variant" size="{{35}}" color="{{filterCount ? 'var(--color-text-inverse)' : 'var(--color-text-secondary)'}}" />
        <text wx:if="{{filterCount}}" class="filter-count">{{filterCount}}</text>
      </button>
    </view>
  </view>

  <view wx:if="{{mode === 'unlocked' && filterOpen}}" class="filter-panel">
    <view class="filter-section">
      <text class="filter-title">年级筛选</text>
      <scroll-view class="filter-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
        <view class="filter-row">
          <button class="filter-chip {{tempGradeId === '' ? 'active' : ''}}" data-id="" bindtap="chooseGrade">全部</button>
          <button wx:for="{{categories}}" wx:key="id" class="filter-chip {{tempGradeId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseGrade">{{item.name}}</button>
        </view>
      </scroll-view>
    </view>
    <view wx:if="{{tempGradeId && subjects.length}}" class="filter-section">
      <text class="filter-title">学科筛选</text>
      <scroll-view class="filter-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
        <view class="filter-row">
          <button class="filter-chip {{tempSubjectId === '' ? 'active' : ''}}" data-id="" bindtap="chooseSubject">全部</button>
          <button wx:for="{{subjects}}" wx:key="id" class="filter-chip {{tempSubjectId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseSubject">{{item.name}}</button>
        </view>
      </scroll-view>
    </view>
    <view wx:if="{{tempSubjectId && knowledgePoints.length}}" class="filter-section">
      <text class="filter-title">知识点筛选</text>
      <scroll-view class="filter-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
        <view class="filter-row">
          <button class="filter-chip {{tempKnowledgePointId === '' ? 'active' : ''}}" data-id="" bindtap="chooseKnowledgePoint">全部</button>
          <button wx:for="{{knowledgePoints}}" wx:key="id" class="filter-chip {{tempKnowledgePointId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseKnowledgePoint">{{item.name}}</button>
        </view>
      </scroll-view>
    </view>
    <view class="filter-actions">
      <button class="reset-filter" bindtap="resetFilters">重置</button>
      <button class="confirm-filter" bindtap="confirmFilters">确定</button>
    </view>
  </view>

  <view class="content {{filterOpen ? 'filter-open-content' : ''}} {{mode === 'unlocked' ? 'unlocked-study-content' : ''}}">
    <view wx:if="{{loading}}" class="loading">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton"></view>
    </view>
    <view wx:elif="{{error}}" class="state">
      <ui-icon name="alert-circle-outline" size="{{78}}" color="var(--color-error)" />
      <text>{{error}}</text>
      <button bindtap="load" data-reset="{{true}}">重新加载</button>
    </view>
    <block wx:else>
      <view wx:if="{{(mode === 'unlocked' && publicItems.length) || (mode === 'private' && privateItems.length)}}" class="list-header">
        <text>共 {{mode === 'unlocked' ? publicItems.length : privateItems.length}} 个卡包</text>
        <button wx:if="{{mode === 'private'}}" class="manage-button" bindtap="toggleManage">
          <ui-icon name="{{editMode ? 'close' : 'cog'}}" size="{{24}}" color="var(--color-primary)" />
          <text>{{editMode ? '取消' : '管理'}}</text>
        </button>
      </view>
      <view wx:if="{{mode === 'unlocked' && publicItems.length}}" class="pack-list">
        <study-pack-list-item
          wx:for="{{publicItems}}"
          wx:key="id"
          item="{{item}}"
          locked="{{item.isVipAccessExpired}}"
          app-icon="{{assets.appIcon}}"
          data-id="{{item.id}}"
          bind:open="openPublic"
          bind:start="startPublic"
        />
      </view>
      <view wx:if="{{mode === 'private' && privateItems.length}}" class="pack-list">
        <view wx:if="{{editMode}}" class="create-placeholder" bindtap="createPack" hover-class="pack-hover">
          <text class="create-plus">＋</text><text>新增卡包</text>
        </view>
        <view wx:for="{{privateItems}}" wx:key="id" class="pack private-pack {{editMode ? 'editing' : ''}}" data-id="{{item.id}}" bindtap="openPrivate" hover-class="pack-hover">
          <button wx:if="{{editMode}}" class="delete-pack" data-id="{{item.id}}" catchtap="deletePack" aria-label="删除卡包">
            <ui-icon name="delete-outline" size="{{27}}" color="var(--color-text-inverse)" />
          </button>
          <view class="cover private-cover-component">
            <private-pack-cover avatar="{{item.author.avatar || userAvatar}}" variant="list" />
          </view>
          <view class="copy">
            <text class="title">{{item.title}}</text>
            <text class="meta">{{item.cardCount || 0}} 张 · 专属卡包</text>
            <text class="description">{{item.description || '点击管理卡片与开始学习'}}</text>
          </view>
          <ui-icon wx:if="{{!editMode}}" name="chevron-right" size="{{32}}" color="var(--color-text-muted)" />
        </view>
      </view>
      <view wx:if="{{(mode === 'unlocked' && !publicItems.length) || (mode === 'private' && !privateItems.length)}}" class="state">
        <ui-icon name="book-open-outline" size="{{82}}" color="var(--color-text)" />
        <text>没有找到匹配的卡包</text>
        <button wx:if="{{mode === 'unlocked'}}" bindtap="goResource">去解锁</button>
        <button wx:else bindtap="createPack">创建卡包</button>
      </view>
      <view wx:if="{{loadingMore}}" class="more">正在加载更多…</view>
    </block>
  </view>

  <view wx:if="{{createOpen}}" class="create-modal-root">
    <view class="create-modal-mask" bindtap="cancelCreatePack"></view>
    <view class="create-modal" catchtap="preventCreateClose">
      <view class="create-modal-heading">
        <text class="create-modal-title">新增卡包</text>
        <text class="create-modal-subtitle">创建一个新的专属卡包</text>
      </view>
      <view class="create-form">
        <label class="create-field">
          <text class="create-label">卡包标题 <text class="required">*</text></text>
          <input
            class="create-input"
            value="{{createTitle}}"
            bindinput="onCreateTitleInput"
            maxlength="{{50}}"
            placeholder="请输入卡包标题"
            focus="{{createOpen}}"
            cursor-spacing="{{24}}"
          />
          <text class="create-count">{{createTitle.length}}/50</text>
        </label>
        <label class="create-field">
          <text class="create-label">卡包描述 <text class="required">*</text></text>
          <textarea
            class="create-textarea"
            value="{{createDescription}}"
            bindinput="onCreateDescriptionInput"
            maxlength="{{200}}"
            placeholder="请输入卡包描述"
            cursor-spacing="{{24}}"
            fixed="{{true}}"
          />
          <text class="create-count">{{createDescription.length}}/200</text>
        </label>
      </view>
      <view class="create-modal-actions">
        <button class="create-cancel" disabled="{{creating}}" bindtap="cancelCreatePack">取消</button>
        <button
          class="create-confirm"
          disabled="{{creating || !canCreate}}"
          bindtap="confirmCreatePack"
        >
          <view wx:if="{{creating}}" class="create-spinner"></view>
          <text>{{creating ? '创建中...' : '确认创建'}}</text>
        </button>
      </view>
    </view>
  </view>
  <app-purchase-guide
    open="{{purchaseGuideOpen}}"
    mode="vip"
    reason="{{purchaseGuideReason}}"
    balance="{{profile && profile.balance || 0}}"
    is-vip="{{profile && profile.vip && profile.vip.isVip}}"
    vip-expire-at="{{profile && profile.vip && profile.vip.vipExpireAt}}"
    daily-reward-amount="{{profile && profile.vip && profile.vip.dailyRewardAmount || 0}}"
    bind:close="closePurchaseGuide"
    bind:success="onVirtualPaymentFulfilled"
  />
</view>
