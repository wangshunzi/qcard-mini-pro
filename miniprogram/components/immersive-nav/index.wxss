:host { display:block; }
.nav { position:fixed; z-index:900; top:0; right:0; left:0; box-sizing:border-box; color:var(--color-text); transition:box-shadow .12s linear,color .12s linear; }
.nav-overlay { pointer-events:none; }
.nav-surface { position:absolute; inset:0; background:var(--nav-background, var(--color-surface-translucent)); transition:opacity .12s linear,backdrop-filter .12s linear; }
.nav-border .nav-surface,.nav-scrolled .nav-surface { border-bottom:1rpx solid var(--color-border-soft); }
.nav-row { position:relative; z-index:1; box-sizing:border-box; display:flex; align-items:center; }
.nav-controls { position:relative; z-index:3; min-width:0; margin-left:16rpx; display:flex; align-items:center; gap:12rpx; overflow:visible; pointer-events:auto; }
.nav-back { width:var(--immersive-control-height); min-width:var(--immersive-control-height); height:var(--immersive-control-height); margin:0; padding:0; display:flex; align-items:center; justify-content:center; flex:none; border:var(--immersive-control-border); border-radius:50%; background:var(--immersive-control-background); box-shadow:var(--immersive-control-shadow); line-height:1; backdrop-filter:blur(18rpx); transition:opacity .15s ease,transform .15s ease,box-shadow .15s ease; }
.nav-back-icon { width:100%; height:100%; display:flex; align-items:center; justify-content:center; line-height:1; transform:translateX(1rpx); }
.nav-control-hover { opacity:.8; transform:scale(.95); box-shadow:0 3rpx 10rpx rgba(24,45,30,.11); }
.nav-leading { min-width:0; flex:none; display:flex; align-items:center; }
.nav-action { min-width:0; flex:none; display:flex; align-items:center; }
.nav-center { position:absolute; right:0; left:0; display:flex; align-items:center; justify-content:center; padding-left:200rpx; pointer-events:none; transition:opacity .12s linear; }
.nav-title { overflow:hidden; font-size:32rpx; font-weight:650; line-height:1; text-align:center; text-overflow:ellipsis; white-space:nowrap; }
