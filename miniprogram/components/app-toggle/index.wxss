:host { display:inline-flex; flex:none; }
.toggle { position:relative; width:92rpx; min-width:92rpx; height:52rpx; margin:0; padding:4rpx; display:flex; align-items:center; box-sizing:border-box; border:2rpx solid #d5dbd5; border-radius:999rpx; background:#edf0ed; box-shadow:inset 0 2rpx 5rpx rgba(32,49,37,.08); line-height:1; transition:background .2s ease,border-color .2s ease,box-shadow .2s ease; }
.toggle::after { border:0; }
.toggle-thumb { width:40rpx; height:40rpx; flex:none; border-radius:50%; background:#fff; box-shadow:0 3rpx 9rpx rgba(27,44,32,.2); transform:translateX(0); transition:transform .2s cubic-bezier(.22,.8,.22,1); }
.toggle.checked { border-color:#529917; background:#529917; box-shadow:inset 0 2rpx 5rpx rgba(44,91,14,.12),0 3rpx 10rpx rgba(82,153,23,.16); }
.toggle.checked .toggle-thumb { transform:translateX(40rpx); }
.toggle[disabled] { opacity:.45; }
