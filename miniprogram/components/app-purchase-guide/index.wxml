<view wx:if="{{open}}" class="purchase-guide {{closing ? 'closing' : ''}}">
  <view class="purchase-backdrop" bindtap="close"></view>
  <view class="purchase-panel" catchtap="preventClose">
    <view class="purchase-handle"></view>

    <view class="purchase-heading">
      <view class="purchase-heading-icon {{mode === 'recharge' ? 'recharge' : 'vip'}}">
        <ui-icon wx:if="{{mode === 'recharge'}}" name="wallet" size="{{42}}" color="#529917" />
        <ui-icon wx:else name="crown" size="{{42}}" color="#b7780b" />
      </view>
      <view class="purchase-heading-copy">
        <text class="purchase-title">{{mode === 'recharge' ? '购买咔豆' : '开通 VIP'}}</text>
        <text class="purchase-subtitle">由微信虚拟支付安全处理，权益发放至当前叩咔账号</text>
      </view>
      <button class="purchase-close" bindtap="close" disabled="{{submittingId}}" aria-label="关闭">
        <ui-icon name="close" size="{{31}}" color="#69726b" />
      </button>
    </view>

    <view wx:if="{{reason}}" class="purchase-reason">{{reason}}</view>

    <view wx:if="{{!capabilitySupported}}" class="purchase-state unsupported-state">
      <ui-icon name="alert-circle-outline" size="{{52}}" color="#d17b20" />
      <text class="state-title">当前设备暂不支持</text>
      <text class="state-copy">{{capabilityReason}}</text>
      <button class="state-action" bindtap="explainUnsupported">查看说明</button>
    </view>

    <view wx:elif="{{loading}}" class="purchase-state">
      <view class="loading-dot"></view>
      <text class="state-copy">正在加载可购买商品…</text>
    </view>

    <view wx:else class="product-list">
      <button
        wx:for="{{products}}"
        wx:key="id"
        class="product-card {{item.purchaseLocked ? 'product-card-confirming' : ''}}"
        data-id="{{item.id}}"
        loading="{{submittingId === item.id}}"
        disabled="{{submittingId}}"
        bindtap="purchase"
        hover-class="product-card-hover"
      >
        <view class="product-copy">
          <view class="product-title-row">
            <text class="product-title">{{item.name}}</text>
            <text wx:if="{{item.badge}}" class="product-badge">{{item.badge}}</text>
          </view>
          <text class="product-benefit">{{item.benefitText}}</text>
          <text wx:if="{{item.description}}" class="product-description">{{item.description}}</text>
          <text wx:if="{{item.purchaseState === 'confirming'}}" class="product-description">上一笔订单确认中，点击可立即查询状态</text>
          <text wx:elif="{{item.purchaseState === 'continue'}}" class="product-description">继续上次未完成的订单</text>
        </view>
        <view class="product-price">
          <text class="currency">¥</text>
          <text>{{item.displayPrice}}</text>
        </view>
      </button>
      <view wx:if="{{error}}" class="inline-error">
        <text>{{error}}</text>
        <button wx:if="{{!products.length}}" bindtap="loadProducts">重试</button>
      </view>
      <view wx:if="{{statusMessage}}" class="payment-status">
        <view class="status-pulse"></view>
        <text>{{statusMessage}}</text>
      </view>
    </view>

    <button class="order-link" bindtap="openOrders" disabled="{{submittingId}}">
      查看购买记录与到账状态
    </button>
    <text class="purchase-note">支付结果与权益发放均成功后才会显示到账；咔豆和 VIP 在同一账号内统一使用</text>
  </view>
</view>
