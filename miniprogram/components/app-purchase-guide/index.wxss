:host { position:fixed; z-index:2200; inset:0; display:block; pointer-events:none; }
.purchase-guide { position:absolute; z-index:2200; inset:0; pointer-events:auto; }
.purchase-backdrop { position:absolute; inset:0; background:rgba(13,32,23,.58); backdrop-filter:blur(10rpx); animation:purchase-fade-in .22s ease-out both; }
.purchase-panel { position:absolute; right:0; bottom:0; left:0; max-height:88vh; padding:0 36rpx calc(30rpx + env(safe-area-inset-bottom)); overflow-y:auto; box-sizing:border-box; border-radius:32rpx 32rpx 0 0; background:#f8faf8; box-shadow:0 -18rpx 54rpx rgba(8,27,17,.22); animation:purchase-panel-in .26s cubic-bezier(.2,.8,.2,1) both; }
.purchase-handle { width:92rpx; height:8rpx; margin:18rpx auto 24rpx; border-radius:999rpx; background:#c9ceca; }
.purchase-heading { display:flex; align-items:center; gap:17rpx; }
.purchase-heading-icon { width:82rpx; height:82rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:22rpx; }
.purchase-heading-icon.vip { background:#fff1cc; }
.purchase-heading-icon.recharge { background:#e7f5dc; }
.purchase-heading-copy { min-width:0; flex:1; display:flex; flex-direction:column; }
.purchase-title { color:#253128; font-size:31rpx; font-weight:800; line-height:1.3; }
.purchase-subtitle { margin-top:7rpx; color:#717b73; font-size:21rpx; line-height:1.4; }
.purchase-close { width:60rpx; height:60rpx; margin:0; padding:0; flex:none; display:flex; align-items:center; justify-content:center; border:0; border-radius:50%; background:#edf0ed; line-height:60rpx; }
.purchase-reason { margin-top:24rpx; padding:20rpx 22rpx; border:1rpx solid #dfe7dc; border-radius:18rpx; color:#435048; background:#f1f6ef; font-size:22rpx; line-height:1.5; }
.purchase-state { min-height:210rpx; margin-top:24rpx; padding:28rpx; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:15rpx; border-radius:22rpx; background:#eef3ef; box-sizing:border-box; text-align:center; }
.unsupported-state { background:#fff7ea; }
.state-title { color:#313c34; font-size:26rpx; font-weight:750; }
.state-copy { color:#69736b; font-size:22rpx; line-height:1.55; }
.state-action { width:auto; min-width:150rpx; height:58rpx; margin:2rpx 0 0; padding:0 24rpx; border:1rpx solid rgba(82,153,23,.38); border-radius:999rpx; color:#529917; background:#fff; font-size:21rpx; line-height:56rpx; }
.loading-dot,.status-pulse { width:20rpx; height:20rpx; border-radius:50%; background:#529917; animation:pulse 1.15s ease-in-out infinite; }
.product-list { margin-top:22rpx; display:flex; flex-direction:column; gap:14rpx; }
.product-card { width:100%; min-height:116rpx; margin:0; padding:20rpx 22rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; border:2rpx solid #e0e7df; border-radius:20rpx; color:#2b352e; background:#fff; box-sizing:border-box; line-height:1.4; text-align:left; }
.product-card-hover { border-color:rgba(82,153,23,.55); background:#f4f9f1; transform:scale(.99); }
.product-card[disabled] { opacity:.68; }
.product-copy { min-width:0; flex:1; display:flex; flex-direction:column; }
.product-title-row { display:flex; align-items:center; gap:10rpx; }
.product-title { overflow:hidden; color:#28332b; font-size:25rpx; font-weight:750; text-overflow:ellipsis; white-space:nowrap; }
.product-badge { padding:3rpx 9rpx; border-radius:999rpx; color:#9a6108; background:#fff0c7; font-size:17rpx; font-weight:700; }
.product-benefit { margin-top:5rpx; color:#529917; font-size:22rpx; font-weight:700; }
.product-description { margin-top:5rpx; overflow:hidden; color:#7a837c; font-size:19rpx; text-overflow:ellipsis; white-space:nowrap; }
.product-price { flex:none; display:flex; align-items:baseline; color:#d76b25; font-size:29rpx; font-weight:800; }
.product-price .currency { margin-right:2rpx; font-size:20rpx; }
.inline-error { padding:19rpx 20rpx; display:flex; align-items:center; justify-content:space-between; gap:12rpx; border-radius:16rpx; color:#9b4e39; background:#fff0ec; font-size:21rpx; line-height:1.45; }
.inline-error button { width:auto; height:50rpx; margin:0; padding:0 20rpx; flex:none; border-radius:999rpx; color:#529917; background:#fff; font-size:20rpx; line-height:50rpx; }
.payment-status { padding:17rpx 20rpx; display:flex; align-items:center; gap:14rpx; border-radius:16rpx; color:#3f5a43; background:#edf7e8; font-size:21rpx; line-height:1.45; }
.status-pulse { width:14rpx; height:14rpx; flex:none; }
.order-link { width:100%; height:68rpx; margin:20rpx 0 0; padding:0; color:#529917; background:transparent; font-size:22rpx; font-weight:650; line-height:68rpx; }
.purchase-note { display:block; color:#7b847d; font-size:19rpx; line-height:1.48; text-align:center; }
.purchase-guide.closing .purchase-backdrop { animation:purchase-fade-out .22s ease-in both; }
.purchase-guide.closing .purchase-panel { animation:purchase-panel-out .22s ease-in both; }
@keyframes purchase-panel-in { from { transform:translateY(100%); } to { transform:translateY(0); } }
@keyframes purchase-panel-out { from { transform:translateY(0); } to { transform:translateY(100%); } }
@keyframes purchase-fade-in { from { opacity:0; } to { opacity:1; } }
@keyframes purchase-fade-out { from { opacity:1; } to { opacity:0; } }
@keyframes pulse { 0%,100% { opacity:.42; transform:scale(.8); } 50% { opacity:1; transform:scale(1.1); } }
