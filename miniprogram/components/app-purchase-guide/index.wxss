:host { position:fixed; z-index:2200; inset:0; display:block; pointer-events:none; }
.purchase-guide { position:absolute; z-index:2200; inset:0; pointer-events:auto; }
.purchase-backdrop { position:absolute; inset:0; background:rgba(13,32,23,.58); backdrop-filter:blur(10rpx); animation:purchase-fade-in .22s ease-out both; }
.purchase-panel { position:absolute; right:0; bottom:0; left:0; padding:0 36rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing:border-box; border-radius:32rpx 32rpx 0 0; background:#f8faf8; box-shadow:0 -18rpx 54rpx rgba(8,27,17,.22); animation:purchase-panel-in .26s cubic-bezier(.2,.8,.2,1) both; }
.purchase-handle { width:92rpx; height:8rpx; margin:18rpx auto 24rpx; border-radius:999rpx; background:#c9ceca; }
.purchase-heading { display:flex; align-items:center; gap:17rpx; }
.purchase-heading-icon { width:82rpx; height:82rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:22rpx; }
.purchase-heading-icon.vip { background:#fff1cc; }
.purchase-heading-icon.recharge { background:#e7f5dc; }
.purchase-heading-copy { min-width:0; flex:1; display:flex; flex-direction:column; }
.purchase-title { color:#253128; font-size:31rpx; font-weight:800; line-height:1.3; }
.purchase-subtitle { margin-top:7rpx; color:#717b73; font-size:21rpx; line-height:1.4; }
.purchase-close { width:60rpx; height:60rpx; margin:0; padding:0; flex:none; display:flex; align-items:center; justify-content:center; border:0; border-radius:50%; background:#edf0ed; line-height:60rpx; }
.purchase-reason { margin-top:28rpx; padding:22rpx 24rpx; border:1rpx solid #f1d49c; border-radius:18rpx; color:#4c3a1b; background:#fff8e8; font-size:23rpx; line-height:1.55; }
.purchase-benefits { margin-top:26rpx; display:grid; grid-template-columns:repeat(3,1fr); gap:14rpx; }
.purchase-benefit { min-width:0; padding:20rpx 8rpx; display:flex; align-items:center; flex-direction:column; gap:10rpx; border-radius:18rpx; color:#687269; background:#eef3ef; font-size:20rpx; text-align:center; }
.purchase-download,.purchase-contact { width:100%; height:82rpx; margin:24rpx 0 0; padding:0; display:flex; align-items:center; justify-content:center; gap:11rpx; border-radius:20rpx; box-sizing:border-box; font-size:25rpx; font-weight:750; line-height:82rpx; }
.purchase-download { color:#fff; background:#529917; box-shadow:0 9rpx 22rpx rgba(82,153,23,.22); }
.purchase-contact { margin-top:16rpx; border:2rpx solid rgba(82,153,23,.42); color:#529917; background:#fff; }
.purchase-download-hover,.purchase-contact-hover { opacity:.86; transform:scale(.985); }
.purchase-note { margin-top:19rpx; display:block; color:#7b847d; font-size:20rpx; line-height:1.45; text-align:center; }
.purchase-guide.closing .purchase-backdrop { animation:purchase-fade-out .22s ease-in both; }
.purchase-guide.closing .purchase-panel { animation:purchase-panel-out .22s ease-in both; }
@keyframes purchase-panel-in { from { transform:translateY(100%); } to { transform:translateY(0); } }
@keyframes purchase-panel-out { from { transform:translateY(0); } to { transform:translateY(100%); } }
@keyframes purchase-fade-in { from { opacity:0; } to { opacity:1; } }
@keyframes purchase-fade-out { from { opacity:1; } to { opacity:0; } }
