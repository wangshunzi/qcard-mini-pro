:host { display:block; }
.menu-button { width:var(--immersive-control-height); height:var(--immersive-control-height); margin:0; padding:0; display:flex; align-items:center; justify-content:center; border:var(--immersive-control-border); border-radius:50%; background:var(--immersive-control-background); box-shadow:var(--immersive-control-shadow); line-height:1; backdrop-filter:blur(18rpx); transition:opacity .15s ease,transform .15s ease,box-shadow .15s ease; }
.menu-button { color:var(--color-text); }
.menu-button.light { color:var(--color-text-inverse); background:var(--immersive-control-background); }
.selection-trigger { max-width:250rpx; height:var(--immersive-control-height); margin:0; padding:0 21rpx; display:flex; align-items:center; gap:8rpx; box-sizing:border-box; border:var(--immersive-control-border); border-radius:999rpx; color:var(--color-text); background:var(--immersive-control-background); box-shadow:var(--immersive-control-shadow); font-size:22rpx; font-weight:700; line-height:1.2; backdrop-filter:blur(18rpx); transition:opacity .15s ease,transform .15s ease,box-shadow .15s ease; }
.selection-trigger.light { border-color:rgba(255,255,255,.4); color:var(--color-text-inverse); background:rgba(15,15,15,.48); }
.selection-trigger-label { min-width:0; max-width:135rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.selection-trigger-image { width:29rpx; height:29rpx; flex:none; }
.selection-trigger-chevron { flex:none; transition:transform .2s ease; }
.selection-trigger.open .selection-trigger-chevron { transform:rotate(180deg); }
.menu-button-hover { opacity:.8; transform:scale(.95); box-shadow:0 3rpx 10rpx rgba(24,45,30,.11); }
.menu-glyph { width:30rpx; display:flex; flex-direction:column; gap:6rpx; }
.menu-glyph text { width:100%; height:3rpx; border-radius:999rpx; background:currentColor; }
.menu-glyph text:nth-child(2) { width:22rpx; }
/* root-portal detaches this node from page variables, so its theme contract lives on the portaled root. */
.side-menu-root { position:fixed; z-index:998; inset:0; --side-menu-panel-background:#ffffff; --side-menu-border:#d2cfcf; --side-menu-text:#0f0f0f; --side-menu-text-secondary:#5d5d5d; --side-menu-primary:#529917; --side-menu-primary-soft:#e5f9ce; --side-menu-warning:#ffb936; --side-menu-warning-soft:#fff7df; --side-menu-surface-soft:#f7f8f6; --side-menu-hover:#f6f6f6; --side-menu-glass:rgba(255,255,255,.92); --side-menu-inverse:#ffffff; }
@media (prefers-color-scheme: dark) { .side-menu-root { --side-menu-panel-background:#141821; --side-menu-border:#262b35; --side-menu-text:#f5f5f7; --side-menu-text-secondary:#c1c4cc; --side-menu-primary:#4fbf6b; --side-menu-primary-soft:#173626; --side-menu-warning:#ffc85a; --side-menu-warning-soft:#3d321f; --side-menu-surface-soft:#11141c; --side-menu-hover:#151821; --side-menu-glass:rgba(20,24,33,.96); --side-menu-inverse:#ffffff; } }
.side-menu-backdrop { position:absolute; inset:0; background:var(--color-overlay, rgba(3,7,15,.76)); backdrop-filter:blur(7rpx); }
.side-menu-panel { position:absolute; top:0; bottom:0; left:0; width:82vw; max-width:610rpx; display:flex; flex-direction:column; isolation:isolate; color:var(--side-menu-text); background-color:var(--side-menu-panel-background); box-shadow:16rpx 0 40rpx rgba(0,0,0,.38); animation:side-menu-in .22s ease-out; }
.side-menu-profile { min-height:210rpx; padding-right:42rpx; padding-bottom:32rpx; padding-left:42rpx; box-sizing:border-box; display:flex; align-items:flex-end; gap:22rpx; border-bottom:1rpx solid var(--side-menu-border); background-color:var(--side-menu-panel-background); }
.side-menu-avatar { width:96rpx; height:96rpx; flex:none; border:1rpx solid var(--side-menu-border); border-radius:50%; background:var(--side-menu-surface-soft); }
.side-menu-user-copy { min-width:0; min-height:96rpx; flex:1; display:flex; flex-direction:column; justify-content:center; }
.side-menu-name-row { min-width:0; display:flex; align-items:center; gap:10rpx; }
.side-menu-name { min-width:0; overflow:hidden; color:var(--side-menu-text); font-size:30rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }
.side-menu-vip-badge { width:auto; height:38rpx; margin:0; padding:0 11rpx; flex:none; display:flex; align-items:center; gap:4rpx; border:0; border-radius:999rpx; color:var(--side-menu-inverse); background:linear-gradient(135deg,#ffb300,#f28a00); font-size:17rpx; font-weight:800; line-height:38rpx; }
.side-menu-vip-badge::after,.side-menu-vip-banner::after { border:0; }
.side-menu-level { margin-top:7rpx; color:var(--side-menu-text-secondary); font-size:22rpx; }
.side-menu-vip-status { margin-top:5rpx; overflow:hidden; color:var(--side-menu-text-secondary); font-size:18rpx; font-weight:500; text-overflow:ellipsis; white-space:nowrap; }
.side-menu-vip-status.active { color:var(--side-menu-warning); }
.side-menu-main { flex:1; padding:28rpx 24rpx 34rpx; background-color:var(--side-menu-panel-background); }
.side-menu-vip-banner { width:100%; min-height:92rpx; margin:0 0 16rpx; padding:14rpx 15rpx; display:flex; align-items:center; gap:12rpx; box-sizing:border-box; border:1rpx solid rgba(243,154,19,.32); border-radius:20rpx; color:var(--side-menu-warning); background:var(--side-menu-warning-soft); line-height:1.2; text-align:left; box-shadow:0 7rpx 20rpx rgba(0,0,0,.12); transition:opacity .15s ease,transform .15s ease; }
.side-menu-vip-icon { width:50rpx; height:50rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--side-menu-glass); }
.side-menu-vip-copy { min-width:0; flex:1; display:flex; flex-direction:column; }
.side-menu-vip-title { overflow:hidden; color:var(--side-menu-warning); font-size:21rpx; font-weight:750; text-overflow:ellipsis; white-space:nowrap; }
.side-menu-vip-subtitle { margin-top:7rpx; overflow:hidden; color:var(--side-menu-warning); font-size:16rpx; text-overflow:ellipsis; white-space:nowrap; }
.side-menu-vip-action { padding:8rpx 11rpx; flex:none; display:flex; align-items:center; gap:1rpx; border-radius:999rpx; color:var(--side-menu-inverse); background:var(--side-menu-warning); font-size:16rpx; font-weight:750; }
.side-menu-vip-hover { opacity:.82; transform:scale(.985); }
.side-menu-row { width:100%; height:96rpx; margin:0; padding:0 28rpx; display:flex; align-items:center; gap:24rpx; border:0; border-radius:18rpx; color:var(--side-menu-text); background:transparent; font-size:27rpx; font-weight:600; line-height:96rpx; text-align:left; }
.side-menu-bottom { min-height:152rpx; padding:20rpx 26rpx 18rpx; display:flex; align-items:flex-start; justify-content:space-around; border-top:1rpx solid var(--side-menu-border); background-color:var(--side-menu-panel-background); }
.side-menu-shortcut { width:126rpx; min-height:104rpx; margin:0; padding:13rpx 10rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:7rpx; border:0; border-radius:17rpx; color:var(--side-menu-text-secondary); background:transparent; font-size:20rpx; line-height:1.2; }
.side-menu-hover { background:var(--side-menu-hover); }
.selection-drawer-header { min-height:244rpx; padding-right:28rpx; padding-bottom:30rpx; padding-left:38rpx; box-sizing:border-box; display:flex; align-items:flex-end; gap:18rpx; border-bottom:1rpx solid var(--side-menu-border); background:linear-gradient(145deg,var(--side-menu-panel-background),var(--side-menu-primary-soft)); }
.selection-drawer-mark { width:76rpx; height:76rpx; flex:none; display:flex; align-items:center; justify-content:center; border:1rpx solid rgba(82,153,23,.2); border-radius:22rpx; background:var(--side-menu-panel-background); box-shadow:0 5rpx 16rpx rgba(54,91,45,.09); }
.selection-drawer-copy { min-width:0; flex:1; padding-bottom:3rpx; display:flex; flex-direction:column; }
.selection-drawer-title { overflow:hidden; color:var(--side-menu-text); font-size:31rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
.selection-drawer-subtitle { margin-top:7rpx; overflow:hidden; color:var(--side-menu-text-secondary); font-size:20rpx; text-overflow:ellipsis; white-space:nowrap; }
.selection-drawer-close { width:60rpx; height:60rpx; margin:0 0 7rpx; padding:0; flex:none; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--side-menu-glass); line-height:60rpx; }
.selection-drawer-list { min-height:0; flex:1; padding:26rpx 22rpx 0; box-sizing:border-box; background:var(--side-menu-panel-background); }
.selection-drawer-item { width:100%; min-height:92rpx; margin:0 0 12rpx; padding:13rpx 18rpx; display:flex; align-items:center; gap:18rpx; box-sizing:border-box; border:1rpx solid transparent; border-radius:20rpx; color:var(--side-menu-text-secondary); background:transparent; font-size:26rpx; font-weight:650; line-height:1.25; text-align:left; transition:background .15s ease,border-color .15s ease,transform .15s ease; }
.selection-drawer-item.selected { border-color:rgba(82,153,23,.2); color:var(--side-menu-primary); background:var(--side-menu-primary-soft); }
.selection-item-label { min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.selection-item-icon { width:56rpx; height:56rpx; flex:none; display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:16rpx; background:var(--side-menu-surface-soft); }
.selection-item-image { width:38rpx; height:38rpx; }
.selection-drawer-item.selected .selection-item-icon { background:var(--side-menu-panel-background); }
.selection-item-check { width:36rpx; height:36rpx; flex:none; display:flex; align-items:center; justify-content:center; box-sizing:border-box; border:2rpx solid var(--side-menu-border); border-radius:50%; background:var(--side-menu-panel-background); }
.selection-item-check.selected { border-color:var(--side-menu-primary); background:var(--side-menu-primary); }
.selection-drawer-hover { opacity:.76; transform:scale(.985); }
.selection-list-bottom-space { height:36rpx; }
@keyframes side-menu-in { from { transform:translateX(-100%); } to { transform:translateX(0); } }
