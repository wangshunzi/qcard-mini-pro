:host { display:block; }
.selection-root { position:fixed; z-index:1600; inset:0; pointer-events:auto; }
.selection-backdrop { position:absolute; inset:0; background:rgba(13,32,23,.52); backdrop-filter:blur(7rpx); animation:selection-fade-in .18s ease-out; }
.selection-panel { position:absolute; top:0; bottom:0; left:0; width:82vw; max-width:610rpx; display:flex; flex-direction:column; overflow:hidden; background:#fff; box-shadow:16rpx 0 40rpx rgba(18,35,25,.16); animation:selection-slide-in .22s ease-out; }
.selection-header { min-height:244rpx; padding-right:28rpx; padding-bottom:30rpx; padding-left:38rpx; box-sizing:border-box; display:flex; align-items:flex-end; gap:18rpx; border-bottom:1rpx solid var(--color-border); background:linear-gradient(145deg,#f7fbf4,#eef6e8); }
.selection-mark { width:76rpx; height:76rpx; flex:none; display:flex; align-items:center; justify-content:center; border:1rpx solid rgba(82,153,23,.2); border-radius:22rpx; background:#fff; box-shadow:0 5rpx 16rpx rgba(54,91,45,.09); }
.selection-copy { min-width:0; flex:1; padding-bottom:3rpx; display:flex; flex-direction:column; }
.selection-title { overflow:hidden; color:var(--color-text); font-size:31rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
.selection-subtitle { margin-top:7rpx; overflow:hidden; color:var(--color-text-secondary); font-size:20rpx; text-overflow:ellipsis; white-space:nowrap; }
.selection-close { width:60rpx; height:60rpx; margin:0 0 7rpx; padding:0; flex:none; display:flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(255,255,255,.8); line-height:60rpx; }
.selection-list { min-height:0; flex:1; padding:26rpx 22rpx 0; box-sizing:border-box; background:#fff; }
.selection-item { width:100%; min-height:92rpx; margin:0 0 12rpx; padding:13rpx 18rpx; display:flex; align-items:center; gap:18rpx; box-sizing:border-box; border:1rpx solid transparent; border-radius:20rpx; color:#4d554f; background:transparent; font-size:26rpx; font-weight:650; line-height:1.25; text-align:left; transition:background .15s ease,border-color .15s ease,transform .15s ease; }
.selection-item.selected { border-color:rgba(82,153,23,.2); color:#31551f; background:#eef8e8; }
.selection-item-label { min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.selection-item-icon { width:56rpx; height:56rpx; flex:none; display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:16rpx; background:#f1f4f0; }
.selection-item-image { width:38rpx; height:38rpx; }
.selection-item.selected .selection-item-icon { background:#fff; }
.selection-check { width:36rpx; height:36rpx; flex:none; display:flex; align-items:center; justify-content:center; box-sizing:border-box; border:2rpx solid #d5dbd5; border-radius:50%; background:#fff; }
.selection-check.selected { border-color:#529917; background:#529917; }
.selection-hover { opacity:.76; transform:scale(.985); }
.selection-bottom-space { height:36rpx; }
@keyframes selection-slide-in { from { transform:translateX(-100%); } to { transform:translateX(0); } }
@keyframes selection-fade-in { from { opacity:0; } to { opacity:1; } }
