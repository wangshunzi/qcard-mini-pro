:host { position:fixed; z-index:1100; inset:0; display:block; pointer-events:none; }
.preview-modal-root { position:fixed; z-index:1100; inset:0; pointer-events:auto; }
.preview-modal-backdrop { position:absolute; inset:0; width:auto; height:auto; margin:0; padding:0; border:0; border-radius:0; background:rgba(15,25,19,.34); backdrop-filter:blur(24rpx) saturate(.92); line-height:normal; }
.preview-modal-backdrop::after { border:0; }
.preview-modal-panel { position:absolute; z-index:3; right:0; bottom:calc(env(safe-area-inset-bottom) + 24rpx); left:0; margin:0 auto; display:flex; flex-direction:column; justify-content:center; box-sizing:border-box; overflow:visible; background:transparent; animation:preview-panel-in .28s cubic-bezier(.22,.8,.22,1) both; }
.preview-source-pack::after,.preview-icon-action::after,.preview-text-action::after { border:0; }
.preview-card-stage { width:100%; height:auto; aspect-ratio:9/16; flex:none; display:flex; align-items:stretch; justify-content:stretch; overflow:visible; background:transparent; }
.preview-modal-card { width:100% !important; height:100% !important; min-width:100%; min-height:100%; flex:1; }
.preview-modal-dock { width:100%; margin-top:20rpx; padding:0; flex:none; border:0; background:transparent; box-shadow:none; }
.preview-source-pack { width:100%; min-height:82rpx; margin:0; padding:9rpx 12rpx; display:flex; align-items:center; box-sizing:border-box; border:0; border-radius:17rpx; color:#344038; background:rgba(255,255,255,.58); line-height:1.2; text-align:left; }
.preview-source-cover { width:58rpx; height:58rpx; flex:none; border-radius:12rpx; background:#e5e9e5; }
.preview-source-copy { min-width:0; margin-left:11rpx; flex:1; display:flex; flex-direction:column; }
.preview-source-title,.preview-source-meta { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.preview-source-title { color:#344038; font-size:21rpx; font-weight:750; }
.preview-source-meta { margin-top:4rpx; color:#7a857d; font-size:17rpx; }
.preview-source-status { margin-left:8rpx; flex:none; display:flex; align-items:center; gap:2rpx; color:#529917; font-size:17rpx; font-weight:700; }
.preview-modal-actions { min-height:68rpx; display:flex; align-items:stretch; gap:10rpx; }
.preview-source-pack + .preview-modal-actions { margin-top:10rpx; }
.preview-icon-action,.preview-text-action { height:66rpx; margin:0; padding:0 19rpx; display:flex; align-items:center; justify-content:center; gap:7rpx; border:0; border-radius:17rpx; color:#45604d; background:rgba(238,244,236,.76); font-size:20rpx; font-weight:750; line-height:1; backdrop-filter:blur(16rpx); }
.preview-icon-action { width:66rpx; min-width:66rpx; padding:0 !important; flex:none; }
.preview-icon-action.feedback { color:#d35f56; }
.preview-icon-action.feedback.processing { color:#d99422; background:#fff7df; }
.preview-icon-action.feedback.resolved { color:#529917; background:#effae7; }
.preview-icon-action.feedback.rejected { color:#d35f56; background:#fff0ed; }
.preview-text-action { min-width:0; flex:1; }
.preview-text-action.primary { color:#fff; background:linear-gradient(145deg,#65aa2e,#478b13); box-shadow:0 5rpx 14rpx rgba(82,153,23,.2); }
.preview-action-hover { opacity:.76; transform:scale(.98); }
.preview-modal-root.closing .preview-modal-panel { animation:preview-panel-out .22s ease-in both; }
.feedback-root { position:absolute; z-index:5; inset:0; }
.feedback-backdrop { position:absolute; inset:0; background:rgba(13,32,23,.46); backdrop-filter:blur(7rpx); animation:feedback-fade-in .22s ease-out both; }
.feedback-sheet { position:absolute; right:0; bottom:0; left:0; padding:20rpx 32rpx 34rpx; border-radius:28rpx 28rpx 0 0; background:#fff; box-shadow:0 -12rpx 36rpx rgba(0,0,0,.18); animation:feedback-in .22s ease-out; }
.feedback-sheet.dragging { animation:none; transform:translateY(var(--feedback-drag-offset)); transition:none; }
.feedback-sheet.drag-settling { animation:none; transform:translateY(var(--feedback-drag-offset)); transition:transform .22s ease-in-out; }
.feedback-drag-area { margin:-20rpx -32rpx 0; padding:20rpx 32rpx 0; }
.feedback-handle { width:92rpx; height:8rpx; margin:0 auto 25rpx; border-radius:999rpx; background:#d0d4d1; }
.feedback-title { display:block; color:#303630; font-size:30rpx; font-weight:750; }
.feedback-input-wrap { margin-top:18rpx; padding:18rpx; border:1rpx solid #dfe5df; border-radius:19rpx; background:#f5f7f4; }
.feedback-input { width:100%; height:210rpx; color:#303630; font-size:23rpx; line-height:1.55; }
.feedback-counter { display:block; color:#8c958e; font-size:18rpx; text-align:right; }
.feedback-buttons { margin-top:20rpx; display:flex; gap:15rpx; }
.feedback-button,.feedback-close-button { height:76rpx; margin:0; flex:1; border-radius:18rpx; color:#303630; background:#f0f3ef; font-size:23rpx; line-height:76rpx; }
.feedback-buttons .feedback-send { color:#fff; background:#529917; }
.feedback-buttons .feedback-send.disabled { opacity:.45; }
.feedback-status { padding:17rpx; display:flex; align-items:center; gap:13rpx; border-radius:17rpx; font-size:25rpx; font-weight:750; }
.feedback-status.processing { color:#ad791b; background:#fff6d8; }
.feedback-status.resolved { color:#438f18; background:#edf9e5; }
.feedback-status.rejected { color:#c6574f; background:#fff0ed; }
.feedback-copy,.admin-reply { display:block; margin-top:19rpx; color:#303630; font-size:23rpx; line-height:1.55; }
.admin-reply { padding:17rpx; border-radius:15rpx; color:#31551f; background:#eef8e8; }
.feedback-close-button { width:100%; margin-top:24rpx; }
@keyframes preview-panel-in { from { opacity:0; transform:translateY(38rpx) scale(.96); } to { opacity:1; transform:translateY(0) scale(1); } }
@keyframes preview-panel-out { from { opacity:1; transform:translateY(0) scale(1); } to { opacity:0; transform:translateY(30rpx) scale(.97); } }
@keyframes feedback-in { from { transform:translateY(100%); } to { transform:translateY(0); } }
@keyframes feedback-out { from { transform:translateY(0); } to { transform:translateY(100%); } }
@keyframes feedback-fade-in { from { opacity:0; } to { opacity:1; } }
@keyframes feedback-fade-out { from { opacity:1; } to { opacity:0; } }
.feedback-root.closing .feedback-backdrop { animation:feedback-fade-out .22s ease-in both; }
.feedback-root.closing .feedback-sheet { animation:feedback-out .22s ease-in both; }
.feedback-root.closing .feedback-sheet.drag-settling { animation:none; }
