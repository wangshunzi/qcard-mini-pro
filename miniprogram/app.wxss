@import "/design-system/theme.wxss";

page {
  min-height: 100%;
  background: var(--color-background);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  /*
   * Overlay navigation does not occupy document flow. Keep hero copy and
   * floating panels below the native capsule row on notched real devices.
   */
  --immersive-content-safe-top: calc(env(safe-area-inset-top) + 192rpx);
  --immersive-panel-safe-top: calc(env(safe-area-inset-top) + 192rpx);
  --immersive-control-height: 72rpx;
  --immersive-control-border: 1rpx solid rgba(255, 255, 255, .82);
  --immersive-control-background: linear-gradient(145deg, rgba(255, 255, 255, .98), rgba(247, 250, 247, .84));
  --immersive-control-shadow: 0 7rpx 20rpx rgba(24, 45, 30, .13), inset 0 1rpx 0 rgba(255, 255, 255, .95);
}

.drawer-selector-trigger { max-width:250rpx; height:var(--immersive-control-height); margin:0; padding:0 21rpx; display:flex; align-items:center; gap:8rpx; box-sizing:border-box; border:var(--immersive-control-border); border-radius:999rpx; color:#3f321f; background:var(--immersive-control-background); box-shadow:var(--immersive-control-shadow); font-size:22rpx; font-weight:700; line-height:1.2; backdrop-filter:blur(18rpx); transition:opacity .15s ease,transform .15s ease,box-shadow .15s ease; }
.drawer-selector-trigger-label { min-width:0; max-width:135rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.drawer-selector-trigger-icon { width:29rpx; height:29rpx; flex:none; }
.drawer-selector-trigger-chevron { flex:none; transition:transform .2s ease; }
.drawer-selector-trigger.open .drawer-selector-trigger-chevron { transform:rotate(180deg); }
.drawer-selector-trigger-hover { opacity:.72; transform:scale(.96); }

.app-segmented { min-width:0; padding:5rpx; display:flex; align-items:stretch; box-sizing:border-box; border:1rpx solid var(--color-border); border-radius:18rpx; background:rgba(241,244,240,.94); box-shadow:inset 0 1rpx 3rpx rgba(31,48,36,.05); }
.app-segmented.nav-segmented { height:var(--immersive-control-height); border-color:rgba(255,255,255,.82); border-radius:999rpx; background:var(--immersive-control-background); box-shadow:var(--immersive-control-shadow); backdrop-filter:blur(18rpx); }
.app-segmented-option { min-width:0; height:100%; margin:0; padding:0 20rpx; flex:1; display:flex; align-items:center; justify-content:center; gap:7rpx; border:0; border-radius:14rpx; color:#69736b; background:transparent; font-size:22rpx; font-weight:600; line-height:1.2; white-space:nowrap; transition:color .18s ease,background .18s ease,box-shadow .18s ease,transform .18s ease; }
.nav-segmented .app-segmented-option { min-width:76rpx; padding:0 16rpx; border-radius:999rpx; font-size:20rpx; }
.app-segmented-option.active { color:#fff; background:linear-gradient(145deg,#65aa2e,#478b13); box-shadow:0 4rpx 12rpx rgba(62,119,18,.22),inset 0 1rpx 0 rgba(255,255,255,.3); font-weight:750; }
.app-segmented-option::after { border:0; }
.app-segmented-option-hover { opacity:.76; transform:scale(.97); }
.app-segmented.icon-segmented { width:136rpx; border-radius:18rpx; }
.app-segmented.icon-segmented .app-segmented-option { min-width:0; padding:0; border-radius:12rpx; }

button::after {
  border: 0;
}

button,
input,
textarea {
  font: inherit;
}

button {
  box-sizing: border-box;
}

.pressable {
  transition: transform 150ms ease, opacity 150ms ease;
}

.pressable-hover {
  opacity: .78;
  transform: scale(.98);
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--page-padding);
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.tab-page {
  padding-bottom: 32rpx;
}

.screen-reader-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}
